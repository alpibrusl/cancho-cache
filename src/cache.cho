edition 5;

import std.addr;
import std.buffer;
import std.conns;
import std.io;
import clients;
import cluster;
import cmdnames;
import commands;
import latency;
import persist;
import pool;
import reply;
import resp;
import slowlog;
import stats;
import store;
import stream;
import txn;

// `cache` -- a Redis-compatible cache (`docs/design.md`): the loop. The commands are `src/commands.cho`, the memory is
// `src/store.cho`, the protocol `src/resp.cho`.
//
//     cache <port> [<arena MiB> [<most keys> [noeviction | allkeys-lru]]]     (64 MiB, 1,000,000 keys, noeviction)
//
// One thread, one poller. A readable connection is read once into its own slot of one slab, every whole command
// in it is parsed and answered into one scratch buffer, and the scratch goes out in a single write: so a client
// that pipelines sixteen commands costs one read and one write, which is what Redis does and what the pipeline
// cells of the gate measure. What the kernel will not take is queued per connection, the connection is then
// watched for room to write instead of for input (so a client that does not read stops being read from), and
// whatever input was already buffered is answered once the queue has drained.
//
// Sizes are fixed at start and nothing is allocated afterwards.

// Connections at once, at most (Redis's default `maxclients`). What a connection owns while it is idle is a row of `state`, a name and a row
// of `txns`; its buffers are lent from the pools below (`docs/design.md` section 21).
fn max_connections() -> [] int {
    return 10000;
}

// How many connections may at once be holding a part of a command (each such holds a block of `input_size()`), have answers the kernel has
// not taken (a block of `output_size()`), or be part way through a transaction (a block of `input_size()` for the queue). One more input
// block than that is shared: a read goes into it, and only what is left over after the whole commands in it have been answered is copied
// into a block of the connection's own.
fn input_blocks() -> [] int {
    return 1024;
}

fn pend_blocks() -> [] int {
    return 256;
}

fn queue_blocks() -> [] int {
    return 128;
}

// Each connection's input buffer: a command must fit in it.
fn input_size() -> [] int {
    return 16384;
}

// How much answer is built before it is sent. Under what a connection may have waiting, so that what the kernel does not take fits the queue
// and a command's answer never makes a client that is slow to read lose its connection.
fn flush_at() -> [] int {
    return 32768;
}

// What one connection may have waiting to be sent.
fn output_size() -> [] int {
    return commands.piece();
}

// Per connection `k`, `state[13k..13k+13]` is:
//
//     0  bytes of input buffered
//     1  1 if the slot is in use
//     2  bytes of output waiting (-1: the queue could not hold it)
//     3  1 if the connection closes once that output has gone
//     4  what it is watched for (1 to read, 2 to write)
//     5  the length of its client name (`CLIENT SETNAME`)
//     6  its client id
//     7  1 if a command asked for the connection to be closed after its answers (`QUIT`)
//     8  the protocol it speaks: 2, or 3 after `HELLO 3`
//     9  where a command that answers in pieces (`MGET`) is to go on from; 0 when none is part way
//     10 the block of `bufs` that holds its unanswered input, or -1 when none is buffered (the shared block is `input_blocks()`)
//     11 the block of `pends` that holds its waiting output, or -1
//     12 the block of `queues` that holds its transaction's commands, or -1
//     13 what it is doing with a value too long for a block (`docs/design.md` section 22): 0 nothing, 1 taking the bytes of a value that is arriving, 3 waiting
//        for the CRLF after them, 4 sending the bytes of a value that is leaving
//     14 mode 1 and 3: the entry being filled (-1: the value is thrown away, its answer already given); mode 4: the entry being sent
//     15 mode 1: bytes of value still to come; mode 4: bytes of value sent
//     16 mode 1 and 3: when the key ends (0: never); mode 4: the stamp of the value when it began to be sent (`store.stamp_of`)
//     17 the store's epoch when the mode began: a `FLUSHALL` makes the entry in 14 mean nothing
//     18 when it connected (the store's milliseconds)
//     19 when it last ran a command, and 20 which (`cmdnames.index_of`; -1 none): what `CLIENT LIST` shows as `idle` and `cmd`
//     21 1 if `CLIENT KILL` chose it: the loop closes it (`docs/design.md` section 32)
//     22 1 if it is in `MONITOR` mode (`docs/design.md` section 34)
fn stride() -> [] int {
    return 23;
}

res struct Core {
    poller: Poller,
    // `poller_wait` fills these with (token, readiness) pairs.
    events: Box[[int]],
    state: Box[[int]],
    bufs: Box[[byte]],
    pends: Box[[byte]],
    // The free blocks of `bufs` (without the shared one), of `pends` and of `queues`: `src/pool.cho`.
    inpool: Box[[int]],
    pendpool: Box[[int]],
    qpool: Box[[int]],
    // The parse table of the command in hand.
    table: Box[[int]],
    // Every answer to one read, before it is written.
    scratch: Box[[byte]],
    // A few bytes for a command to build a value in (`INCR`).
    tmp: Box[[byte]],
    // Each connection's client name, 64 bytes a slot; and counters about the whole server (`src/session.cho`: connections, start time,
    // commands answered, connections accepted, port, the next client id).
    names: Box[[byte]],
    info: Box[[int]],
    // Each connection's transaction: a row of `txn.stride()` ints, and a queue of `input_size()` bytes lent while it has commands (`src/txn.cho`).
    txns: Box[[int]],
    queues: Box[[byte]],
    store: store.Store,
    // The directory of the snapshot (`--dir=`, `docs/design.md` section 35): its path, and how long it is (0: no persistence).
    dir: Box[[byte]],
    dir_len: int,
    // When the sweep for expired keys last ran, in the store's milliseconds.
    swept: int,
}

// ---------------------------------------------------------------------
// One connection's bytes
// ---------------------------------------------------------------------

// Hand `data` to the kernel without waiting for room, and keep what it did not take.
//
// `pend[0..pending]` is what this connection already has waiting. If there is none, `data` is offered to the
// connection straight away; if there is some, the new bytes queue behind it or the answers would arrive out
// of order. Answers the new `pending`, or -1 if the queue cannot hold the rest (a client that is not reading and
// has asked for more than the buffer) or the connection has failed: the caller closes it.
fn emit[&c, &d, &e](table: &!c conns.Table, slot: int, data: &d [byte], pend: &!e [byte], pending: int) -> [conn_write] int {
    var at = 0;
    if pending == 0 {
        match conns.write(table, slot, data) {
            Sent::Wrote(n) => {
                at = n;
            }
            Sent::Again => {
            }
            Sent::Failed(e) => {
                return 0 - 1;
            }
        }
    }
    if at >= len(data) {
        return pending;
    }
    if pending + len(data) - at > len(pend) {
        return 0 - 1;
    }
    var i = at;
    while i < len(data) {
        pend[pending + i - at] = data[i];
        i = i + 1;
    }
    return pending + len(data) - at;
}

// Give back every block connection `k` has been lent.
fn return_blocks[&c](core: &!c Core, k: int) -> [] int {
    let st = contents(core.state);
    let p = stride() * k;
    if st[p + 10] >= 0 {
        pool.give(contents(core.inpool), st[p + 10]);
        st[p + 10] = 0 - 1;
    }
    if st[p + 11] >= 0 {
        pool.give(contents(core.pendpool), st[p + 11]);
        st[p + 11] = 0 - 1;
    }
    if st[p + 12] >= 0 {
        pool.give(contents(core.qpool), st[p + 12]);
        st[p + 12] = 0 - 1;
    }
    return 0;
}

fn shut[&t, &c](tab: &!t conns.Table, core: &!c Core, k: int) -> [] int {
    let st = contents(core.state);
    if st[stride() * k + 22] == 1 {
        st[stride() * k + 22] = 0;
        stats.add_monitors(contents(core.info), 0 - 1);
    }
    conns.close(tab, k);
    // A value that was arriving is given up.
    if st[stride() * k + 13] != 0 && st[stride() * k + 13] != 4 && st[stride() * k + 14] >= 0 && st[stride() * k + 17] == store.epoch_of(core.store) {
        store.abort(core.store, st[stride() * k + 14]);
    }
    st[stride() * k + 13] = 0;
    return_blocks(core, k);
    st[stride() * k + 1] = 0;
    return 0;
}

// Watch `k` for what it now waits on: room to write if output is queued (and read no more), input otherwise.
fn settle[&t, &c](tab: &!t conns.Table, core: &!c Core, k: int) -> [poll] int {
    let st = contents(core.state);
    let p = stride() * k;
    var want = 1;
    if st[p + 2] > 0 || st[p + 13] == 4 {
        want = 2;
    }
    if want != st[p + 4] {
        conns.rewatch(tab, core.poller, k, k + 1, want);
        st[p + 4] = want;
    }
    return 0;
}

// Send the value of the entry connection `k` is sending (mode 4), a piece at a time while the kernel takes them, and at most `send_turn()` bytes in one go, so
// that one big value does not hold up the others: when it stops with the mode still 4 and nothing waiting, the connection is watched for room to write and
// comes back. If the value has been written since it began to go (or the keys were flushed) the answer cannot be finished and the connection is closed.
fn send_turn() -> [] int {
    return 262144;
}

fn pump_get[&t, &c](tab: &!t conns.Table, core: &!c Core, k: int, ops: int, ope: int) -> [conn_write] int {
    let st = contents(core.state);
    let pd = contents(core.pends);
    let p = stride() * k;
    var budget = send_turn();
    while st[p + 13] == 4 && st[p + 2] == 0 && budget > 0 {
        let e = st[p + 14];
        if st[p + 17] != store.epoch_of(core.store) || !store.unchanged(core.store, e, st[p + 16]) {
            st[p + 2] = 0 - 1;
            st[p + 13] = 0;
        } else {
            let total = len(store.value(core.store, e));
            var c = total - st[p + 15];
            if c > flush_at() {
                c = flush_at();
            }
            if c > 0 {
                st[p + 2] = emit(tab, k, store.value(core.store, e)[st[p + 15]..st[p + 15] + c], pd[ops..ope], st[p + 2]);
            }
            st[p + 15] = st[p + 15] + c;
            budget = budget - c - 1;
            if st[p + 15] >= total && st[p + 2] >= 0 {
                st[p + 2] = emit(tab, k, "\r\n", pd[ops..ope], st[p + 2]);
                st[p + 13] = 0;
            }
        }
    }
    return 0;
}

// Answer every whole command buffered for connection `k`, write the answers, and keep the start of one that
// is still arriving. Closes the connection if it is to close, or cannot be written to.
// Whether the command in `tb` is timed for the slow log (`docs/design.md` section 31): every command if the threshold is a millisecond or less, otherwise only the ones
// that can take a while, so that a lookup of one key does not pay for two reads of the clock. Never if the log is off.
fn slow_timed[&c, &v, &w](core: &c Core, view: &v [byte], tb: &w [int], idx: int) -> [] bool {
    let limit = store.slow_threshold_of(core.store);
    // `CONFIG` is always timed: it may be the command that switches the log on, and it is then judged by the new threshold.
    // The latency monitor (`docs/design.md` section 33) reads the same clock: with a threshold of a millisecond any command may reach it.
    let lat = store.lat_threshold_of(core.store);
    return limit >= 0 && (limit <= 1000 || tb[0] > 8 || cmdnames.may_be_slow(idx)) || lat > 0 && (lat <= 1 || tb[0] > 8 || cmdnames.may_be_slow(idx)) || tb[0] > 0 && reply.is_word(reply.arg_of(view, tb, 0), "CONFIG");
}

// After a timed command ran: it took until now from `began`; if that is as long as the threshold (as it is *now*, so that the command that sets it is judged by the new
// value, as in Redis) it is logged.
fn slow_after[&t, &c, &v, &w, &q, &b](tab: &!t conns.Table, core: &!c Core, k: int, view: &v [byte], tb: &w [int], began: int, clock: &q Clock, sc: &b [byte], from: int, to: int) -> [clock] int {
    // The clock counts whole milliseconds, so a command that took 0.1 ms across a tick reads as 1: an event is noted only when the reading is *more* than the threshold, which
    // means the command really took longer (`docs/design.md` section 33).
    let ms = clock_ms(clock) - began;
    let took = ms * 1000;
    let limit = store.slow_threshold_of(core.store);
    let lat = store.lat_threshold_of(core.store);
    if (limit >= 0 && took >= limit || lat > 0 && ms > lat) && !stats.did_not_run(sc, from, to) {
        if limit >= 0 && took >= limit {
            slow_note(tab, core, k, view, tb, took);
        }
        if lat > 0 && ms > lat {
            var event = 1;
            if cmdnames.may_be_slow(cmdnames.index_of(reply.arg_of(view, tb, 0))) {
                event = 0;
            }
            latency.record(core.store, event, (store.wall_of(core.store) + store.now_of(core.store)) / 1000, ms);
        }
    }
    return 0;
}

// Log the command line in `view` as slow: it took `usec` microseconds. The client's address and name are looked up now, which only a slow command pays for.
fn slow_note[&t, &c, &v, &w](tab: &!t conns.Table, core: &!c Core, k: int, view: &v [byte], tb: &w [int], usec: int) -> [] int {
    let name_length = contents(core.state)[stride() * k + 5];
    region r {
        let buf = alloc_slice[r](64, byte_of(0));
        var n = 0;
        match conns.peer(tab, k) {
            conns.Peered::Known(peer) => {
                n = addr.text_port(peer, buf);
            }
            conns.Peered::Unavailable(e) => {
            }
        }
        let secs = (store.wall_of(core.store) + store.now_of(core.store)) / 1000;
        slowlog.record(core.store, view, tb, secs, usec, buf[0..n], contents(core.names)[k * 64..k * 64 + name_length]);
    }
    return 0;
}

// The text of `data` as Redis's `MONITOR` shows an argument: in quotes, `\\`, `\"`, `\n`, `\r`, `\t`, `\a` and `\b` escaped, other bytes outside 32..126 as `\xHH`.
fn put_repr[&b, &d](sc: &!b [byte], at: int, data: &d [byte]) -> [] int {
    let digits = "0123456789abcdef";
    var o = reply.put_byte(sc, at, '"');
    var i = 0;
    while i < len(data) {
        let ch = int_of(data[i]);
        if ch == '\\' || ch == '"' {
            o = reply.put_byte(sc, reply.put_byte(sc, o, '\\'), ch);
        } else if ch == 10 {
            o = reply.put(sc, o, "\\n");
        } else if ch == 13 {
            o = reply.put(sc, o, "\\r");
        } else if ch == 9 {
            o = reply.put(sc, o, "\\t");
        } else if ch == 7 {
            o = reply.put(sc, o, "\\a");
        } else if ch == 8 {
            o = reply.put(sc, o, "\\b");
        } else if ch >= 32 && ch < 127 {
            o = reply.put_byte(sc, o, ch);
        } else {
            o = reply.put(sc, o, "\\x");
            o = reply.put_byte(sc, o, int_of(digits[ch / 16]));
            o = reply.put_byte(sc, o, int_of(digits[ch % 16]));
        }
        i = i + 1;
    }
    return reply.put_byte(sc, o, '"');
}

// Show the command `tb` describes in `view`, which connection `k` has just run, to every connection in `MONITOR` mode (`docs/design.md` section 34): `+<seconds>.<microseconds> [0
// <address>] "arg" ...`, the arguments of `AUTH` redacted, the commands `MONITOR` leaves out (`cmdnames.skips_monitor`, which includes `MONITOR`) not shown. The line is built in `sc` after `at`; a watching
// connection that cannot take it (its queue is full) is closed, as Redis closes a client that falls too far behind. If `k` is itself watching its line goes after its own answer:
// the answer is `at` bytes, and the new `at` is answered.
fn monitor_feed[&t, &c, &v, &w, &b](tab: &!t conns.Table, core: &!c Core, k: int, view: &v [byte], tb: &w [int], sc: &!b [byte], at: int) -> [conn_write, poll] int {
    if stats.monitors(contents(core.info)) == 0 || tb[0] < 1 {
        return at;
    }
    let idx = cmdnames.index_of(reply.arg_of(view, tb, 0));
    var sub = view[0..0];
    if tb[0] >= 2 {
        sub = reply.arg_of(view, tb, 1);
    }
    if cmdnames.skips_monitor(idx, sub) {
        return at;
    }
    let st = contents(core.state);
    let pd = contents(core.pends);
    let ms = store.wall_of(core.store) + store.now_of(core.store);
    var o = reply.put_byte(sc, reply.put_nat(sc, reply.put_byte(sc, at, '+'), ms / 1000), '.');
    let us = ms % 1000 * 1000;
    var div = 100000;
    while div > 0 {
        o = reply.put_byte(sc, o, '0' + us / div % 10);
        div = div / 10;
    }
    o = reply.put(sc, o, " [0 ");
    region r {
        let buf = alloc_slice[r](64, byte_of(0));
        let m = clients.peer_text(tab, k, buf);
        o = reply.put(sc, o, buf[0..m]);
    }
    o = reply.put_byte(sc, o, ']');
    var i = 0;
    while i < tb[0] {
        o = reply.put_byte(sc, o, ' ');
        if slowlog.redacted(view, tb, i) {
            o = put_repr(sc, o, "(redacted)");
        } else {
            o = put_repr(sc, o, reply.arg_of(view, tb, i));
        }
        i = i + 1;
    }
    o = reply.put(sc, o, "\r\n");
    var q = 0;
    while q < conns.slots(tab) {
        let pq = stride() * q;
        if st[pq + 1] == 1 && st[pq + 22] == 1 && q != k {
            if st[pq + 11] < 0 && st[pq + 2] == 0 {
                st[pq + 11] = pool.take(contents(core.pendpool));
            }
            var ops = 0;
            var ope = 0;
            if st[pq + 11] >= 0 {
                ops = st[pq + 11] * output_size();
                ope = ops + output_size();
            }
            st[pq + 2] = emit(tab, q, sc[at..o], pd[ops..ope], st[pq + 2]);
            if st[pq + 2] < 0 {
                shut(tab, core, q);
            } else {
                settle(tab, core, q);
            }
        }
        q = q + 1;
    }
    if st[stride() * k + 22] == 1 {
        return o;
    }
    return at;
}

// A write that did something counts as a change for the policy `save <seconds> <changes>`: a command Redis flags `write` that ran and whose answer is neither an error nor the integer 0
// (`DEL` of nothing, a `SETNX` that did not set). One for each command, not one for each key it touched as Redis counts (`MSET` of three keys is one here, three there).
fn note_change[&c, &b](core: &!c Core, idx: int, sc: &b [byte], from: int, to: int) -> [] int {
    if idx >= 0 && cmdnames.is_write(idx) && to > from && !stats.did_not_run(sc, from, to) && int_of(sc[from]) != '-' {
        if !(to - from == 4 && int_of(sc[from]) == ':' && int_of(sc[from + 1]) == '0') {
            store.add_dirty(core.store, 1);
        }
    }
    return 0;
}

// Run the command `tb` describes in `view`: `CLIENT LIST`, `INFO` and `KILL`, which look at other connections, are answered here (`src/clients.cho`), every other by `commands`.
fn execute_in[&t, &c, &v, &w, &b, &z](tab: &!t conns.Table, core: &!c Core, k: int, view: &v [byte], tb: &w [int], sc: &!b [byte], at: int, fs: &z Fs("")) -> [fs_read(""), dir_write, file_read, file_write] int {
    let st = contents(core.state);
    let p = stride() * k;
    if tb[0] >= 1 && reply.is_word(reply.arg_of(view, tb, 0), "MONITOR") {
        if tb[0] != 1 {
            return reply.put(sc, at, "-ERR wrong number of arguments for 'monitor' command\r\n");
        }
        if st[p + 22] == 1 {
            // Already watching: Redis ignores it and does not answer.
            return at;
        }
        st[p + 22] = 1;
        stats.add_monitors(contents(core.info), 1);
        return reply.put(sc, at, "+OK\r\n");
    }
    if st[p + 22] == 1 {
        // A connection that is watching is a replica as far as Redis is concerned: it may not touch the keyspace, and `RESET` ends the watching.
        var sub = view[0..0];
        if tb[0] >= 2 {
            sub = reply.arg_of(view, tb, 1);
        }
        if tb[0] >= 1 && reply.is_word(reply.arg_of(view, tb, 0), "RESET") {
            st[p + 22] = 0;
            stats.add_monitors(contents(core.info), 0 - 1);
        } else if tb[0] >= 1 && cmdnames.touches_keyspace(cmdnames.index_of(reply.arg_of(view, tb, 0)), sub) {
            return reply.put(sc, at, "-ERR Replica can't interact with the keyspace\r\n");
        }
    }
    if tb[0] >= 1 && reply.is_word(reply.arg_of(view, tb, 0), "SAVE") {
        if tb[0] != 1 {
            return reply.put(sc, at, "-ERR wrong number of arguments for 'save' command\r\n");
        }
        if core.dir_len == 0 {
            return reply.put(sc, at, "-ERR persistence is off: start the cache with --dir=<directory> (docs/design.md section 35)\r\n");
        }
        let job = contents(core.info)[stats.persist_at()..stats.persist_at() + stats.persist_ints()];
        if job[0] != 0 {
            return reply.put(sc, at, "-ERR Background save already in progress\r\n");
        }
        let now_ms = store.wall_of(core.store) + store.now_of(core.store);
        let failed = persist.save(fs, contents(core.dir)[0..core.dir_len], core.store, now_ms);
        if failed != 0 {
            job[8] = failed;
            let o = reply.put_nat(sc, reply.put(sc, at, "-ERR the snapshot could not be written (errno "), failed);
            return reply.put(sc, o, ")\r\n");
        }
        job[7] = now_ms / 1000;
        job[8] = 0;
        store.set_dirty(core.store, 0);
        return reply.put(sc, at, "+OK\r\n");
    }
    if tb[0] >= 1 && reply.is_word(reply.arg_of(view, tb, 0), "SHUTDOWN") {
        // `SHUTDOWN [NOSAVE | SAVE] [NOW] [FORCE] [ABORT]`: saves first if a snapshot is wanted (`SAVE`, or a policy and no `NOSAVE`), and then the cache stops, with no answer
        // to anybody (`docs/design.md` section 37). `NOW` and `FORCE` are taken and mean nothing here (there are no replicas to wait for, and a failed save is never overridden).
        var save = false;
        var nosave = false;
        var i = 1;
        while i < tb[0] {
            let word = reply.arg_of(view, tb, i);
            if reply.is_word(word, "SAVE") {
                save = true;
            } else if reply.is_word(word, "NOSAVE") {
                nosave = true;
            } else if reply.is_word(word, "ABORT") {
                return reply.put(sc, at, "-ERR No shutdown in progress.\r\n");
            } else if !reply.is_word(word, "NOW") && !reply.is_word(word, "FORCE") {
                return reply.put(sc, at, "-ERR syntax error\r\n");
            }
            i = i + 1;
        }
        if save && nosave {
            return reply.put(sc, at, "-ERR syntax error\r\n");
        }
        let job = contents(core.info)[stats.persist_at()..stats.persist_at() + stats.persist_ints()];
        let policy = store.save_at(core.store, 0) > 0;
        if (save || policy && !nosave) && core.dir_len > 0 {
            if job[0] == 1 {
                // A save is under way: the last one written would be old; finish with a whole one of our own.
                job[0] = 0;
            }
            let now_ms = store.wall_of(core.store) + store.now_of(core.store);
            if persist.save(fs, contents(core.dir)[0..core.dir_len], core.store, now_ms) != 0 {
                return reply.put(sc, at, "-ERR Errors trying to SHUTDOWN. Check logs.\r\n");
            }
            job[7] = now_ms / 1000;
            job[8] = 0;
            store.set_dirty(core.store, 0);
        } else if save {
            return reply.put(sc, at, "-ERR Errors trying to SHUTDOWN. Check logs.\r\n");
        }
        job[13] = 1;
        st[p + 7] = 1;
        return at;
    }
    if tb[0] >= 1 && reply.is_word(reply.arg_of(view, tb, 0), "LASTSAVE") {
        if tb[0] != 1 {
            return reply.put(sc, at, "-ERR wrong number of arguments for 'lastsave' command\r\n");
        }
        return reply.put_integer(sc, at, contents(core.info)[stats.persist_at() + 7]);
    }
    if tb[0] >= 1 && reply.is_word(reply.arg_of(view, tb, 0), "BGSAVE") {
        if tb[0] > 2 {
            return reply.put(sc, at, "-ERR syntax error\r\n");
        }
        if tb[0] == 2 && !reply.is_word(reply.arg_of(view, tb, 1), "SCHEDULE") {
            return reply.put(sc, at, "-ERR syntax error\r\n");
        }
        if core.dir_len == 0 {
            return reply.put(sc, at, "-ERR persistence is off: start the cache with --dir=<directory> (docs/design.md section 35)\r\n");
        }
        let job = contents(core.info)[stats.persist_at()..stats.persist_at() + stats.persist_ints()];
        if job[0] != 0 {
            return reply.put(sc, at, "-ERR Background save already in progress\r\n");
        }
        let failed = persist.begin(fs, contents(core.dir)[0..core.dir_len], core.store, job, store.wall_of(core.store) + store.now_of(core.store));
        if failed != 0 {
            job[8] = failed;
            let o = reply.put_nat(sc, reply.put(sc, at, "-ERR the snapshot could not be started (errno "), failed);
            return reply.put(sc, o, ")\r\n");
        }
        job[12] = store.dirty_of(core.store);
        job[14] = (store.wall_of(core.store) + store.now_of(core.store)) / 1000;
        return reply.put(sc, at, "+Background saving started\r\n");
    }
    if tb[0] >= 2 && reply.is_word(reply.arg_of(view, tb, 0), "CLIENT") {
        let sub = reply.arg_of(view, tb, 1);
        let listing = reply.is_word(sub, "LIST");
        let info = reply.is_word(sub, "INFO");
        if info && tb[0] != 2 {
            return reply.put(sc, at, "-ERR wrong number of arguments for 'client|info' command\r\n");
        }
        if listing || info {
            if !clients.fits(sc, at, conns.live(tab)) {
                return reply.put(sc, at, "-ERR too many clients to list in one reply (docs/design.md section 32)\r\n");
            }
            var only = 0 - 1;
            if info {
                only = k;
            }
            return clients.list(tab, view, tb, sc, at, st, stride(), contents(core.names), contents(core.txns), txn.stride(), conns.slots(tab), store.now_of(core.store), only);
        }
        if reply.is_word(sub, "KILL") {
            let end = clients.kill(tab, view, tb, sc, at, st, stride(), conns.slots(tab), k);
            var q = 0;
            while q < conns.slots(tab) {
                if st[stride() * q + 21] != 0 {
                    st[stride() * q + 21] = 0;
                    if q == k {
                        st[p + 7] = 1;
                    } else {
                        shut(tab, core, q);
                    }
                }
                q = q + 1;
            }
            return end;
        }
    }
    return commands.execute(view, tb, sc, at, core.store, contents(core.tmp), st[p + 5..p + 10], contents(core.names)[k * 64..k * 64 + 64], contents(core.info));
}

fn process[&t, &c, &q, &z](tab: &!t conns.Table, core: &!c Core, k: int, clock: &q Clock, fs: &z Fs("")) -> [conn_write, poll, clock, fs_read(""), dir_write, file_read, file_write] int {
    let st = contents(core.state);
    let bf = contents(core.bufs);
    let pd = contents(core.pends);
    let sc = contents(core.scratch);
    let tb = contents(core.table);
    let tall = contents(core.txns);
    let qall = contents(core.queues);
    let size = input_size();
    let p = stride() * k;
    // The input is in the block the connection holds, or, if it holds none, in the shared one the read went into.
    var cur = st[p + 10];
    if cur < 0 {
        cur = input_blocks();
    }
    let base = cur * size;
    // A block for the answers the kernel may not take. If there is none to lend, the answers are still offered to the kernel and the connection
    // is closed only if it does not take them all.
    if st[p + 11] < 0 && st[p + 2] == 0 {
        st[p + 11] = pool.take(contents(core.pendpool));
    }
    var ops = 0;
    var ope = 0;
    if st[p + 11] >= 0 {
        ops = st[p + 11] * output_size();
        ope = ops + output_size();
    }
    var used = 0;
    var at = 0;
    var going = true;
    while going {
        // A value that is being sent goes first, and the commands after it wait for it.
        if st[p + 13] == 4 && st[p + 2] == 0 && st[p + 3] == 0 {
            if at > 0 {
                st[p + 2] = emit(tab, k, sc[0..at], pd[ops..ope], st[p + 2]);
                at = 0;
            }
            if st[p + 2] == 0 {
                pump_get(tab, core, k, ops, ope);
            }
        }
        if st[p + 2] != 0 || st[p + 3] != 0 || st[p + 13] == 4 || used >= st[p] {
            going = false;
        } else if st[p + 13] == 1 {
            // The bytes of a value that is arriving: into the record reserved for it, or nowhere.
            var take = st[p] - used;
            if take > st[p + 15] {
                take = st[p + 15];
            }
            if st[p + 14] >= 0 && st[p + 17] != store.epoch_of(core.store) {
                // The keys were flushed under it; the record is gone.
                st[p + 14] = 0 - 1;
                at = reply.put(sc, at, "-ERR the keys were flushed while the value was arriving\r\n");
            }
            if st[p + 14] >= 0 {
                store.fill(core.store, st[p + 14], store.staged_size(core.store, st[p + 14]) - st[p + 15], bf[base + used..base + used + take]);
            }
            st[p + 15] = st[p + 15] - take;
            used = used + take;
            if st[p + 15] == 0 {
                st[p + 13] = 3;
            }
        } else if st[p + 13] == 3 {
            // The CRLF after the value; then the command is done.
            if st[p] - used < 2 {
                going = false;
            } else if int_of(bf[base + used]) != '\r' || int_of(bf[base + used + 1]) != '\n' {
                if st[p + 14] >= 0 && st[p + 17] == store.epoch_of(core.store) {
                    store.abort(core.store, st[p + 14]);
                }
                st[p + 13] = 0;
                at = reply.put(sc, at, "-ERR Protocol error: expected CRLF after bulk\r\n");
                st[p + 3] = 1;
                going = false;
            } else {
                used = used + 2;
                if st[p + 14] >= 0 {
                    if st[p + 17] == store.epoch_of(core.store) {
                        at = stream.finish(sc, at, core.store, st[p + 14], st[p + 16]);
                    } else {
                        at = reply.put(sc, at, "-ERR the keys were flushed while the value was arriving\r\n");
                    }
                }
                st[p + 13] = 0;
                contents(core.info)[2] = contents(core.info)[2] + 1;
                if at >= flush_at() || at + commands.reserve() > len(sc) {
                    st[p + 2] = emit(tab, k, sc[0..at], pd[ops..ope], st[p + 2]);
                    at = 0;
                }
            }
        } else {
            let view = bf[base + used..base + st[p]];
            var n = resp.parse(view, tb);
            if n == resp.streaming() {
                // The last argument is too long for a block: `SET` and `SETEX` take it in pieces, nothing else does.
                if !stream.can(view, tb) {
                    at = reply.put(sc, at, "-ERR Protocol error: command too large\r\n");
                    st[p + 3] = 1;
                    going = false;
                } else {
                    let last = tb[0] - 1;
                    let vstart = tb[1 + 2 * last];
                    let vlen = tb[2 + 2 * last];
                    let tx = tall[txn.stride() * k..txn.stride() * k + txn.stride()];
                    var entry = 0 - 1;
                    var expiry = 0;
                    if tx[0] == 1 {
                        // It cannot be queued: the same as a command that does not fit the queue.
                        tx[1] = 1;
                        at = reply.put(sc, at, "-ERR transaction queue is full\r\n");
                    } else {
                        let (after, e2, x2) = stream.begin(view, tb, sc, at, core.store);
                        at = after;
                        entry = e2;
                        expiry = x2;
                    }
                    st[p + 13] = 1;
                    st[p + 14] = entry;
                    st[p + 15] = vlen;
                    st[p + 16] = expiry;
                    st[p + 17] = store.epoch_of(core.store);
                    used = used + vstart;
                }
            } else if n == 0 {
                if used == 0 && st[p] >= size {
                    at = reply.put(sc, at, "-ERR Protocol error: command too large\r\n");
                    st[p + 3] = 1;
                }
                going = false;
            } else if n < 0 {
                at = reply.put(sc, at, "-ERR ");
                at = reply.put(sc, at, resp.error_text(n));
                if n == resp.error_expected_bulk() {
                    at = reply.put_byte(sc, at, tb[0]);
                    at = reply.put(sc, at, "'");
                }
                at = reply.put(sc, at, "\r\n");
                st[p + 3] = 1;
                going = false;
            } else {
                // `MULTI` and its kin, and a command inside a transaction, are answered or queued by `txn`; everything else is run here.
                let tx = tall[txn.stride() * k..txn.stride() * k + txn.stride()];
                // A queue is lent from the first command after `MULTI`; if there is none to lend, the queue is full.
                if tx[0] == 1 && st[p + 12] < 0 {
                    st[p + 12] = pool.take(contents(core.qpool));
                }
                var qlo = 0;
                var qhi = 0;
                if st[p + 12] >= 0 {
                    qlo = st[p + 12] * size;
                    qhi = qlo + size;
                }
                // In cluster mode a command whose keys another node owns is refused here, before the transaction layer sees it: queued inside `MULTI` it is
                // refused when it is queued and `EXEC` then answers `EXECABORT`, as in Redis (`docs/design.md` section 29).
                let reply_from = at;
                var cmd_idx = 0 - 1;
                if tb[0] > 0 {
                    cmd_idx = cmdnames.index_of(reply.arg_of(view, tb, 0));
                    st[p + 19] = store.now_of(core.store);
                    if cmd_idx >= 0 {
                        st[p + 20] = cmd_idx;
                    }
                }
                let refused = cluster.route(view, tb, sc, at, contents(core.info));
                var status = 0;
                if refused != at {
                    at = refused;
                    if tx[0] == 1 {
                        tx[1] = 1;
                    }
                    status = 1;
                } else {
                    let txn_timed = slow_timed(core, view, tb, cmd_idx);
                    var txn_began = 0;
                    if txn_timed {
                        txn_began = clock_ms(clock);
                    }
                    let (after, handled) = txn.handle(view, tb, sc, at, core.store, tx, qall[qlo..qhi], st[p + 5..p + 10], n);
                    at = after;
                    status = handled;
                    if txn_timed && status == 1 {
                        slow_after(tab, core, k, view, tb, txn_began, clock, sc, reply_from, at);
                    }
                }
                if status == 0 {
                    // A `GET` of a value too long for a buffer is sent in pieces.
                    let (after, ge) = stream.get_begin(view, tb, sc, at, core.store);
                    if ge >= 0 {
                        at = after;
                        st[p + 13] = 4;
                        st[p + 14] = ge;
                        st[p + 15] = 0;
                        st[p + 16] = store.stamp_of(core.store, ge);
                        st[p + 17] = store.epoch_of(core.store);
                    } else {
                        let timed = slow_timed(core, view, tb, cmd_idx);
                        var began = 0;
                        if timed {
                            began = clock_ms(clock);
                        }
                        at = execute_in(tab, core, k, view, tb, sc, at, fs);
                        if timed {
                            slow_after(tab, core, k, view, tb, began, clock, sc, reply_from, at);
                        }
                    }
                }
                if status == 0 && st[p + 9] != 0 {
                    // A command that answers in pieces (`MGET`) wrote one and has more to say. What it wrote goes out now; the command stays
                    // where it is in the input, and when the answers have gone (this turn, or the one the socket can take more in) it is parsed
                    // again and goes on from where `st[p + 9]` says.
                    st[p + 2] = emit(tab, k, sc[0..at], pd[ops..ope], st[p + 2]);
                    at = 0;
                    n = 0;
                } else {
                    contents(core.info)[2] = contents(core.info)[2] + 1;
                    // The command is counted for `INFO commandstats`, and an error reply for `errorstats` (`docs/design.md` section 30).
                    if tb[0] > 0 {
                        stats.record(contents(core.info), cmd_idx, sc, reply_from, at);
                        note_change(core, cmd_idx, sc, reply_from, at);
                        if st[p + 9] == 0 && status != 2 && !stats.did_not_run(sc, reply_from, at) {
                            at = monitor_feed(tab, core, k, view, tb, sc, at);
                        }
                    }
                }
                if status == 2 {
                    // `EXEC`: run what was queued, one command at a time, the answers going out as they fill. If the client is not reading and the
                    // answers cannot all be sent, it stops where it is (`tx[22]`, `tx[23]`), stays at the `EXEC` in the input, and goes on when the
                    // socket can take more: the same way a command that answers in pieces does. While it waits, other connections' commands run,
                    // so an `EXEC` that has to wait for its client is no longer atomic with them; one that does not wait still is.
                    let queue = qall[qlo..qhi];
                    var qi = tx[23];
                    var running = true;
                    while running && qi < tx[2] {
                        let qview = queue[qi..tx[2]];
                        let qn = resp.parse(qview, tb);
                        if qn <= 0 {
                            qi = tx[2];
                        } else {
                            var done = true;
                            if reply.is_word(reply.arg_of(qview, tb, 0), "UNWATCH") {
                                // The watches were checked already and `clear` below forgets them.
                                at = reply.put(sc, at, "+OK\r\n");
                            } else {
                                let exec_from = at;
                                let timed = slow_timed(core, qview, tb, cmdnames.index_of(reply.arg_of(qview, tb, 0)));
                                var began = 0;
                                if timed {
                                    began = clock_ms(clock);
                                }
                                at = execute_in(tab, core, k, qview, tb, sc, at, fs);
                                if timed {
                                    slow_after(tab, core, k, qview, tb, began, clock, sc, exec_from, at);
                                }
                                if st[p + 9] == 0 && !stats.did_not_run(sc, exec_from, at) {
                                    note_change(core, cmdnames.index_of(reply.arg_of(qview, tb, 0)), sc, exec_from, at);
                                    at = monitor_feed(tab, core, k, qview, tb, sc, at);
                                }
                                if st[p + 9] != 0 {
                                    // Part way through a command that answers in pieces: what it wrote goes out, and it is called again.
                                    st[p + 2] = emit(tab, k, sc[0..at], pd[ops..ope], st[p + 2]);
                                    at = 0;
                                    done = false;
                                    if st[p + 2] != 0 {
                                        running = false;
                                    }
                                }
                            }
                            if done {
                                qi = qi + qn;
                                if at >= flush_at() || at + commands.reserve() > len(sc) {
                                    st[p + 2] = emit(tab, k, sc[0..at], pd[ops..ope], st[p + 2]);
                                    at = 0;
                                    if st[p + 2] != 0 {
                                        running = false;
                                    }
                                }
                            }
                        }
                    }
                    if qi < tx[2] && st[p + 2] > 0 {
                        tx[22] = 1;
                        tx[23] = qi;
                        n = 0;
                    } else {
                        txn.clear(tx);
                        // `EXEC` itself is shown after the commands it ran.
                        if resp.parse(view, tb) > 0 {
                            at = monitor_feed(tab, core, k, view, tb, sc, at);
                        }
                    }
                }
                if st[p + 7] == 1 {
                    st[p + 3] = 1;
                    going = false;
                }
                used = used + n;
                // Room for the biggest answer one command can make, and no more than the queue for a slow client can take at once: once
                // that much is waiting the loop stops, leaving the commands after it in the input until the client has read.
                if at >= flush_at() || at + commands.reserve() > len(sc) {
                    st[p + 2] = emit(tab, k, sc[0..at], pd[ops..ope], st[p + 2]);
                    at = 0;
                }
            }
        }
    }
    if at > 0 && st[p + 2] >= 0 {
        st[p + 2] = emit(tab, k, sc[0..at], pd[ops..ope], st[p + 2]);
    }
    if st[p + 2] < 0 {
        shut(tab, core, k);
        return 0;
    }
    var at_front = 0;
    while at_front < st[p] - used {
        bf[base + at_front] = bf[base + used + at_front];
        at_front = at_front + 1;
    }
    st[p] = st[p] - used;
    // A transaction that is over gives its queue back.
    if st[p + 12] >= 0 && tall[txn.stride() * k] == 0 && tall[txn.stride() * k + 22] == 0 {
        pool.give(contents(core.qpool), st[p + 12]);
        st[p + 12] = 0 - 1;
    }
    if st[p + 3] == 1 && st[p + 2] == 0 {
        shut(tab, core, k);
        return 0;
    }
    // The input left over: kept in a block of the connection's own, which the shared block cannot be; and a block that is no longer needed goes back.
    if cur == input_blocks() {
        if st[p] > 0 {
            let b = pool.take(contents(core.inpool));
            if b < 0 {
                // Nowhere to keep the part of a command that has arrived.
                shut(tab, core, k);
                return 0;
            }
            var i = 0;
            while i < st[p] {
                bf[b * size + i] = bf[base + i];
                i = i + 1;
            }
            st[p + 10] = b;
        }
    } else if st[p] == 0 {
        pool.give(contents(core.inpool), cur);
        st[p + 10] = 0 - 1;
    }
    if st[p + 2] == 0 && st[p + 11] >= 0 {
        pool.give(contents(core.pendpool), st[p + 11]);
        st[p + 11] = 0 - 1;
    }
    settle(tab, core, k);
    return 0;
}

// The poller said connection `k` is ready.
fn step[&t, &c, &q, &z](tab: &!t conns.Table, core: &!c Core, k: int, readiness: int, clock: &q Clock, fs: &z Fs("")) -> [conn_read, conn_write, poll, clock, fs_read(""), dir_write, file_read, file_write] int {
    let st = contents(core.state);
    let bf = contents(core.bufs);
    let pd = contents(core.pends);
    let size = input_size();
    let p = stride() * k;
    var cur = st[p + 10];
    if cur < 0 {
        cur = input_blocks();
    }
    let base = cur * size;
    if st[p + 2] > 0 && st[p + 11] < 0 {
        // Output waiting and nowhere it is kept: cannot be, and a connection in that state is of no use.
        shut(tab, core, k);
        return 0;
    }
    let obase = st[p + 11] * output_size();
    if st[p + 13] == 4 && st[p + 2] == 0 {
        // A value is being sent and the last of it went: the connection is watched for room to write, and has some.
        if readiness % 4 >= 2 {
            process(tab, core, k, clock, fs);
        } else if readiness % 2 == 1 {
            shut(tab, core, k);
        }
        return 0;
    }
    if st[p + 2] > 0 {
        // Waiting to send: the kernel can take more.
        if readiness % 4 >= 2 {
            match conns.write(tab, k, pd[obase..obase + st[p + 2]]) {
                Sent::Wrote(sent) => {
                    var at = 0;
                    while at < st[p + 2] - sent {
                        pd[obase + at] = pd[obase + sent + at];
                        at = at + 1;
                    }
                    st[p + 2] = st[p + 2] - sent;
                    if st[p + 2] == 0 {
                        if st[p + 3] == 1 {
                            shut(tab, core, k);
                        } else {
                            // Held back while the last answers were being sent.
                            pool.give(contents(core.pendpool), st[p + 11]);
                            st[p + 11] = 0 - 1;
                            process(tab, core, k, clock, fs);
                        }
                    }
                }
                Sent::Again => {
                }
                Sent::Failed(e) => {
                    shut(tab, core, k);
                }
            }
        } else if readiness % 2 == 1 {
            // The peer has gone, or said something while we are not listening.
            shut(tab, core, k);
        }
    } else if st[p] >= size {
        // No room to read into and nothing to send: a command that can never fit was answered already.
        shut(tab, core, k);
    } else {
        match conns.read(tab, k, bf[base + st[p]..base + size]) {
            Received::Data(got) => {
                st[p] = st[p] + got;
                process(tab, core, k, clock, fs);
            }
            Received::End => {
                shut(tab, core, k);
            }
            Received::Again => {
            }
            Received::Failed(e) => {
                shut(tab, core, k);
            }
        }
    }
    return 0;
}

// Take every connection waiting on the listener, up to the limit: each goes in the table, is made
// non-blocking, and is watched for input under the token `slot + 1` (the listener is token 0).
fn accept_all[&h, &l, &c](heap: &!h Heap, conn: conns.Table, listener: &!l Listener, core: &!c Core) -> [heap, conn_accept, poll] conns.Table {
    let st = contents(core.state);
    var table = conn;
    var more = true;
    while more {
        match tcp_accept(listener) {
            Accepted::Ok(c) => {
                var held = 0;
                borrow table as &tt in {
                    held = conns.live(tt);
                }
                if held >= max_connections() {
                    conn_close(c);
                } else {
                    let (grown, slot) = conns.put(heap, table, c);
                    table = grown;
                    if slot >= 0 {
                        let p = stride() * slot;
                        st[p] = 0;
                        st[p + 1] = 1;
                        st[p + 2] = 0;
                        st[p + 3] = 0;
                        st[p + 4] = 1;
                        st[p + 5] = 0;
                        // Client ids count from 1, as Redis's do; `info[5]` is the next.
                        contents(core.info)[5] = contents(core.info)[5] + 1;
                        st[p + 6] = contents(core.info)[5];
                        st[p + 7] = 0;
                        st[p + 8] = 2;
                        st[p + 9] = 0;
                        st[p + 10] = 0 - 1;
                        st[p + 11] = 0 - 1;
                        st[p + 12] = 0 - 1;
                        st[p + 13] = 0;
                        st[p + 18] = store.now_of(core.store);
                        st[p + 19] = store.now_of(core.store);
                        st[p + 20] = 0 - 1;
                        st[p + 21] = 0;
                        st[p + 22] = 0;
                        txn.clear(contents(core.txns)[txn.stride() * slot..txn.stride() * slot + txn.stride()]);
                        contents(core.info)[3] = contents(core.info)[3] + 1;
                        borrow mut table as &!ct in {
                            if conns.nonblocking(ct, slot) != 0 || conns.watch(ct, core.poller, slot, slot + 1, 1) != 0 {
                                shut(ct, core, slot);
                            }
                        }
                    }
                }
            }
            Accepted::Again => {
                more = false;
            }
            Accepted::Failed(e) => {
                more = false;
            }
        }
    }
    return table;
}

// ---------------------------------------------------------------------
// The loop
// ---------------------------------------------------------------------

fn run[&h, &l, &k, &c, &z, &d](heap: &!h Heap, listener: &!l Listener, clock: &k Clock, fs: &z Fs(""), dirpath: &d [byte], savetext: &d [byte], port: int, memory: int, max_keys: int, policy: int, seed: int, clustered: bool, map: &c [byte]) -> [heap, conn_accept, conn_read, conn_write, poll, clock, fs_read(""), dir_read, dir_write, file_read, file_write] int {
    match poller_new() {
        Polling::Ok(p) => {
            var poller = p;
            borrow mut poller as &!pw in {
                poller_add_listener(pw, listener, 0);
            }
            let limit = max_connections();
            var core = Core { poller: poller, events: box_slice(heap, 128, 0), state: box_slice(heap, stride() * limit, 0), bufs: box_slice(heap, (input_blocks() + 1) * input_size(), byte_of(0)), pends: box_slice(heap, pend_blocks() * output_size(), byte_of(0)), inpool: box_slice(heap, input_blocks() + 1, 0), pendpool: box_slice(heap, pend_blocks() + 1, 0), qpool: box_slice(heap, queue_blocks() + 1, 0), table: box_slice(heap, resp.slots(), 0), scratch: box_slice(heap, 3 * commands.reserve(), byte_of(0)), tmp: box_slice(heap, 64, byte_of(0)), names: box_slice(heap, limit * 64, byte_of(0)), info: box_slice(heap, cluster.world_size() + stats.size(), 0), txns: box_slice(heap, txn.stride() * limit, 0), queues: box_slice(heap, queue_blocks() * input_size(), byte_of(0)), store: store.open(heap, memory, max_keys, seed, policy), dir: box_slice(heap, 4096, byte_of(0)), dir_len: 0, swept: 0 };
            var tab = conns.empty(heap, 64);
            var bad_map = false;
            var bad_dump = 0;
            borrow mut core as &!cw in {
                pool.fill(contents(cw.inpool));
                pool.fill(contents(cw.pendpool));
                pool.fill(contents(cw.qpool));
                store.tick(cw.store, clock_ms(clock));
                store.set_wall(cw.store, clock_unix_ms(clock));
                contents(cw.info)[1] = store.now_of(cw.store);
                contents(cw.info)[4] = port;
                if clustered && cluster.configure(contents(cw.info), map[10..len(map)], port) != 0 {
                    bad_map = true;
                }
                // The snapshot, if there is a directory for one, is loaded before the first connection is accepted. A file that is there and is not a snapshot (truncated, altered,
                // from another version) stops the start: the cache does not run on half of what it was given (`docs/design.md` section 35).
                if len(dirpath) > 0 && len(dirpath) <= 4096 && !bad_map {
                    let copy = contents(cw.dir);
                    var j = 0;
                    while j < len(dirpath) {
                        copy[j] = dirpath[j];
                        j = j + 1;
                    }
                    cw.dir_len = len(dirpath);
                    contents(cw.info)[stats.persist_at() + 7] = (store.wall_of(cw.store) + store.now_of(cw.store)) / 1000;
                    let (loaded, kept) = persist.load(fs, dirpath, heap, cw.store);
                    if loaded > persist.absent() {
                        bad_dump = loaded;
                    }
                }
                // `--save=900:1,300:10`: the policy to start with (`CONFIG SET save` changes it).
                if len(savetext) > 0 {
                    let pairs = store.save_points(cw.store);
                    if persist.read_save(savetext, pairs) < 0 {
                        bad_map = true;
                    }
                }
            }
            var stopping = false;
            // A map that is not one stops the start (status 2), after the state is given back like any other stop.
            while !bad_map && bad_dump == 0 && !stopping {
                var ready = 0 - 1;
                borrow mut core as &!cw in {
                    // Wake often enough to take keys whose time has come, but only if there are any.
                    var wait_ms = 1000;
                    if store.keys_with_expiry(cw.store) > 0 {
                        wait_ms = 100;
                    }
                    // A compaction part way through is finished while the cache is idle, a slice a turn; so is a save.
                    if store.compacting(cw.store) || contents(cw.info)[stats.persist_at()] != 0 {
                        wait_ms = 0;
                    }
                    ready = poller_wait(cw.poller, contents(cw.events), wait_ms);
                    // The time, once for this turn: every use of a key in it is stamped with it.
                    store.tick(cw.store, clock_ms(clock));
                }
                // The turn's own time, not the wait before it: the longest one is what `INFO` reports as `max_turn_ms`.
                let turn_start = clock_ms(clock);
                var j = 0;
                while j < ready {
                    var token = 0 - 1;
                    var readiness = 0;
                    borrow core as &cr in {
                        token = contents(cr.events)[2 * j];
                        readiness = contents(cr.events)[2 * j + 1];
                    }
                    if token == 0 {
                        borrow mut core as &!cw in {
                            tab = accept_all(heap, tab, listener, cw);
                        }
                    } else {
                        borrow mut tab as &!tw in {
                            borrow mut core as &!cw in {
                                if contents(cw.state)[stride() * (token - 1) + 1] == 1 {
                                    step(tw, cw, token - 1, readiness, clock, fs);
                                }
                            }
                        }
                    }
                    j = j + 1;
                }
                borrow mut core as &!cw in {
                    borrow tab as &tr in {
                        contents(cw.info)[0] = conns.live(tr);
                    }
                    stats.sample(contents(cw.info), store.now_of(cw.store), contents(cw.info)[2]);
                    store.note_peak(cw.store);
                    // Work the arena's reclaiming ahead of need, a slice at a time (the sets do some themselves).
                    store.reclaim(cw.store, 1024);
                    // A save under way writes one slice of itself (`docs/design.md` section 36): about 256 KiB, so no client waits for more than that.
                    let job = contents(cw.info)[stats.persist_at()..stats.persist_at() + stats.persist_ints()];
                    let now_ms = store.wall_of(cw.store) + store.now_of(cw.store);
                    if job[0] != 0 {
                        persist.step(fs, contents(cw.dir)[0..cw.dir_len], cw.store, job, 262144, now_ms);
                        // A save that finished settles the writes it began with (those after it are still to save).
                        if job[0] == 0 && job[8] == 0 {
                            var left = store.dirty_of(cw.store) - job[12];
                            if left < 0 {
                                left = 0;
                            }
                            store.set_dirty(cw.store, left);
                        }
                    } else if cw.dir_len > 0 && job[13] == 0 {
                        // The policy: a `save <seconds> <changes>` pair is due when that many writes have happened and that many seconds have passed since the last save (and, after a
                        // failed one, five seconds since it was tried). Redis takes the same rule (`serverCron`).
                        let now_s = now_ms / 1000;
                        var pair = 0;
                        var due = false;
                        while pair < store.save_pairs() {
                            let seconds = store.save_at(cw.store, 2 * pair);
                            if seconds > 0 && store.dirty_of(cw.store) >= store.save_at(cw.store, 2 * pair + 1) && now_s - job[7] >= seconds && (job[8] == 0 || now_s - job[14] >= 5) {
                                due = true;
                            }
                            pair = pair + 1;
                        }
                        if due {
                            let failed = persist.begin(fs, contents(cw.dir)[0..cw.dir_len], cw.store, job, now_ms);
                            job[14] = now_s;
                            if failed != 0 {
                                job[8] = failed;
                            } else {
                                job[12] = store.dirty_of(cw.store);
                            }
                        }
                    }
                    if job[13] == 1 {
                        stopping = true;
                    }
                    // Take the keys whose time has passed that nobody asked for again: at most a hundred times a second,
                    // 256 keys at a look, and again while more than a quarter of what it looked at had run out (Redis's
                    // rule), at most sixteen looks.
                    let took = clock_ms(clock) - turn_start;
                    if took > contents(cw.info)[6] {
                        contents(cw.info)[6] = took;
                    }
                    if store.now_of(cw.store) - cw.swept >= 10 {
                        cw.swept = store.now_of(cw.store);
                        var looks = 0;
                        var more = true;
                        while more && looks < 16 {
                            more = store.sweep(cw.store, 256) * 4 > 256;
                            looks = looks + 1;
                        }
                    }
                }
            }
            conns.drop(heap, tab);
            let Core { poller, events, state, bufs, pends, inpool, pendpool, qpool, table, scratch, tmp, names, info, txns, queues, store, dir, dir_len, swept } = core;
            poller_close(poller);
            unbox_slice(heap, events);
            unbox_slice(heap, state);
            unbox_slice(heap, bufs);
            unbox_slice(heap, pends);
            unbox_slice(heap, inpool);
            unbox_slice(heap, pendpool);
            unbox_slice(heap, qpool);
            unbox_slice(heap, table);
            unbox_slice(heap, scratch);
            unbox_slice(heap, tmp);
            unbox_slice(heap, names);
            unbox_slice(heap, info);
            unbox_slice(heap, txns);
            unbox_slice(heap, queues);
            unbox_slice(heap, dir);
            store.close(heap, store);
            if bad_map {
                return 2;
            }
            if bad_dump != 0 {
                return 100 + bad_dump;
            }
            return 0;
        }
        Polling::Failed(e) => {
            return 4;
        }
    }
}

// Whether `text` begins with `prefix`.
fn has_prefix[&t](text: &t [byte], prefix: &static [byte]) -> [] bool {
    if len(text) < len(prefix) {
        return false;
    }
    var i = 0;
    while i < len(prefix) {
        if text[i] != prefix[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn number_of[&t](text: &t [byte]) -> [] int {
    if len(text) == 0 || len(text) > 9 {
        return 0 - 1;
    }
    var n = 0;
    var i = 0;
    while i < len(text) {
        let c = int_of(text[i]);
        if c < '0' || c > '9' {
            return 0 - 1;
        }
        n = n * 10 + (c - '0');
        i = i + 1;
    }
    return n;
}

// The seed the server hashes keys with: eight bytes of the OS entropy (issue #12). 0, the old
// constant, if `/dev/urandom` cannot be read, so a host without one still starts.
fn seed_from[&f](fs: &f Fs("")) -> [fs_read("")] int {
    region a {
        let raw = alloc_slice[a](8, byte_of(0));
        let got = fs_read(fs, "/dev/urandom", raw);
        if got != 8 {
            return 0;
        }
        var n = 0;
        var i = 7;
        while i >= 0 {
            n = n << 8 | int_of(raw[i]) & 0xff;
            i = i - 1;
        }
        return n;
    }
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock } = split(world);
    release(ffi);
    var port = 0 - 1;
    borrow args as &g in {
        if arg_count(g) > 1 {
            port = number_of(arg(g, 1));
        }
    }
    var megabytes = 64;
    var max_keys = 1000000;
    var policy = store.evict_none();
    var seed = 0 - 1;
    var cluster_at = 0;
    var dir_at = 0;
    var save_at = 0;
    borrow args as &g in {
        if arg_count(g) > 4 {
            let named = store.policy_named(arg(g, 4));
            if named >= 0 {
                policy = named;
            } else if arg(g, 4)[0] == byte_of('a') {
                // The old spelling: anything starting with "a" was allkeys-lru.
                policy = store.evict_lru();
            }
        }
        if arg_count(g) > 2 {
            megabytes = number_of(arg(g, 2));
        }
        if arg_count(g) > 3 {
            max_keys = number_of(arg(g, 3));
        }
        if arg_count(g) > 5 {
            seed = number_of(arg(g, 5));
        }
        // `--cluster=0-5460=127.0.0.1:7000,...`: the static slot map (any argument after the sixth).
        var k = 6;
        while k < arg_count(g) {
            if has_prefix(arg(g, k), "--cluster=") {
                cluster_at = k;
            }
            // `--dir=/var/lib/cache`: where the snapshot is kept (`docs/design.md` section 35).
            if has_prefix(arg(g, k), "--dir=") {
                dir_at = k;
            }
            if has_prefix(arg(g, k), "--save=") {
                save_at = k;
            }
            k = k + 1;
        }
    }
    if seed < 0 {
        borrow fs as &f in {
            seed = seed_from(f);
        }
    }
    var status = 2;
    if port > 0 && port < 65536 && megabytes > 0 && megabytes <= 4096 && max_keys > 0 && max_keys <= 100000000 {
        status = 3;
        borrow net as &nn in {
            match tcp_listen(nn, port, 1024, 0) {
                Listening::Ok(l) => {
                    var listener = l;
                    borrow mut listener as &!lh in {
                        listener_nonblocking(lh);
                        borrow mut heap as &!h in {
                            borrow mut io as &!i in {
                                var line = buffer.append(h, buffer.empty(h, 64), "listening on ");
                                line = buffer.push_nat(h, line, port);
                                line = buffer.push(h, line, byte_of(10));
                                borrow line as &lb in {
                                    io.error_all(i, buffer.bytes(lb));
                                }
                                buffer.drop(h, line);
                            }
                            borrow clock as &c in {
                                borrow fs as &fr in {
                                    borrow args as &ga in {
                                        var dirpath = arg(ga, 0)[0..0];
                                        var savetext = arg(ga, 0)[0..0];
                                        if save_at > 0 {
                                            savetext = arg(ga, save_at)[7..len(arg(ga, save_at))];
                                        }
                                        if dir_at > 0 {
                                            dirpath = arg(ga, dir_at)[6..len(arg(ga, dir_at))];
                                        }
                                        status = run(h, lh, c, fr, dirpath, savetext, port, megabytes * 1048576, max_keys, policy, seed, cluster_at > 0, arg(ga, cluster_at));
                                        if status >= 100 {
                                            borrow mut io as &!i in {
                                                var refusal = buffer.append(h, buffer.empty(h, 64), "refusing to start: ");
                                                refusal = buffer.append(h, refusal, persist.tag(status - 100));
                                                refusal = buffer.push(h, refusal, byte_of(10));
                                                borrow refusal as &rb in {
                                                    io.error_all(i, buffer.bytes(rb));
                                                }
                                                buffer.drop(h, refusal);
                                            }
                                            status = 4;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    listener_close(listener);
                }
                Listening::Failed(e) => {
                }
            }
        }
    }
    release(net);
    release(clock);
    release(args);
    release(fs);
    release(io);
    release(heap);
    return status;
}
