edition 5;

import std.buffer;
import std.conns;
import std.io;
import commands;
import pool;
import reply;
import resp;
import store;
import stream;
import txn;

// `cache` -- a Redis-compatible cache (`docs/design.md`): the loop. The commands are `src/commands.cho`, the memory is
// `src/store.cho`, the protocol `src/resp.cho`.
//
//     cache <port> [<arena MiB> [<most keys> [noeviction | allkeys-lru]]]     (64 MiB, 1,000,000 keys, noeviction)
//
// One thread, one poller. A readable connection is read once into its own slot of one slab, every whole command
// in it is parsed and answered into one scratch buffer, and the scratch goes out in a single write: so a client
// that pipelines sixteen commands costs one read and one write, which is what Redis does and what the pipeline
// cells of the gate measure. What the kernel will not take is queued per connection, the connection is then
// watched for room to write instead of for input (so a client that does not read stops being read from), and
// whatever input was already buffered is answered once the queue has drained.
//
// Sizes are fixed at start and nothing is allocated afterwards.

// Connections at once, at most (Redis's default `maxclients`). What a connection owns while it is idle is a row of `state`, a name and a row
// of `txns`; its buffers are lent from the pools below (`docs/design.md` section 21).
fn max_connections() -> [] int {
    return 10000;
}

// How many connections may at once be holding a part of a command (each such holds a block of `input_size()`), have answers the kernel has
// not taken (a block of `output_size()`), or be part way through a transaction (a block of `input_size()` for the queue). One more input
// block than that is shared: a read goes into it, and only what is left over after the whole commands in it have been answered is copied
// into a block of the connection's own.
fn input_blocks() -> [] int {
    return 1024;
}

fn pend_blocks() -> [] int {
    return 256;
}

fn queue_blocks() -> [] int {
    return 128;
}

// Each connection's input buffer: a command must fit in it.
fn input_size() -> [] int {
    return 16384;
}

// How much answer is built before it is sent. Under what a connection may have waiting, so that what the kernel does not take fits the queue
// and a command's answer never makes a client that is slow to read lose its connection.
fn flush_at() -> [] int {
    return 32768;
}

// What one connection may have waiting to be sent.
fn output_size() -> [] int {
    return commands.piece();
}

// Per connection `k`, `state[13k..13k+13]` is:
//
//     0  bytes of input buffered
//     1  1 if the slot is in use
//     2  bytes of output waiting (-1: the queue could not hold it)
//     3  1 if the connection closes once that output has gone
//     4  what it is watched for (1 to read, 2 to write)
//     5  the length of its client name (`CLIENT SETNAME`)
//     6  its client id
//     7  1 if a command asked for the connection to be closed after its answers (`QUIT`)
//     8  the protocol it speaks: 2, or 3 after `HELLO 3`
//     9  where a command that answers in pieces (`MGET`) is to go on from; 0 when none is part way
//     10 the block of `bufs` that holds its unanswered input, or -1 when none is buffered (the shared block is `input_blocks()`)
//     11 the block of `pends` that holds its waiting output, or -1
//     12 the block of `queues` that holds its transaction's commands, or -1
//     13 what it is doing with a value too long for a block (`docs/design.md` section 22): 0 nothing, 1 taking the bytes of a value that is arriving, 3 waiting
//        for the CRLF after them, 4 sending the bytes of a value that is leaving
//     14 mode 1 and 3: the entry being filled (-1: the value is thrown away, its answer already given); mode 4: the entry being sent
//     15 mode 1: bytes of value still to come; mode 4: bytes of value sent
//     16 mode 1 and 3: when the key ends (0: never); mode 4: the stamp of the value when it began to be sent (`store.stamp_of`)
//     17 the store's epoch when the mode began: a `FLUSHALL` makes the entry in 14 mean nothing
fn stride() -> [] int {
    return 18;
}

res struct Core {
    poller: Poller,
    // `poller_wait` fills these with (token, readiness) pairs.
    events: Box[[int]],
    state: Box[[int]],
    bufs: Box[[byte]],
    pends: Box[[byte]],
    // The free blocks of `bufs` (without the shared one), of `pends` and of `queues`: `src/pool.cho`.
    inpool: Box[[int]],
    pendpool: Box[[int]],
    qpool: Box[[int]],
    // The parse table of the command in hand.
    table: Box[[int]],
    // Every answer to one read, before it is written.
    scratch: Box[[byte]],
    // A few bytes for a command to build a value in (`INCR`).
    tmp: Box[[byte]],
    // Each connection's client name, 64 bytes a slot; and counters about the whole server (`src/session.cho`: connections, start time,
    // commands answered, connections accepted, port, the next client id).
    names: Box[[byte]],
    info: Box[[int]],
    // Each connection's transaction: a row of `txn.stride()` ints, and a queue of `input_size()` bytes lent while it has commands (`src/txn.cho`).
    txns: Box[[int]],
    queues: Box[[byte]],
    store: store.Store,
    // When the sweep for expired keys last ran, in the store's milliseconds.
    swept: int,
}

// ---------------------------------------------------------------------
// One connection's bytes
// ---------------------------------------------------------------------

// Hand `data` to the kernel without waiting for room, and keep what it did not take.
//
// `pend[0..pending]` is what this connection already has waiting. If there is none, `data` is offered to the
// connection straight away; if there is some, the new bytes queue behind it or the answers would arrive out
// of order. Answers the new `pending`, or -1 if the queue cannot hold the rest (a client that is not reading and
// has asked for more than the buffer) or the connection has failed: the caller closes it.
fn emit[&c, &d, &e](table: &!c conns.Table, slot: int, data: &d [byte], pend: &!e [byte], pending: int) -> [conn_write] int {
    var at = 0;
    if pending == 0 {
        match conns.write(table, slot, data) {
            Sent::Wrote(n) => {
                at = n;
            }
            Sent::Again => {
            }
            Sent::Failed(e) => {
                return 0 - 1;
            }
        }
    }
    if at >= len(data) {
        return pending;
    }
    if pending + len(data) - at > len(pend) {
        return 0 - 1;
    }
    var i = at;
    while i < len(data) {
        pend[pending + i - at] = data[i];
        i = i + 1;
    }
    return pending + len(data) - at;
}

// Give back every block connection `k` has been lent.
fn return_blocks[&c](core: &!c Core, k: int) -> [] int {
    let st = contents(core.state);
    let p = stride() * k;
    if st[p + 10] >= 0 {
        pool.give(contents(core.inpool), st[p + 10]);
        st[p + 10] = 0 - 1;
    }
    if st[p + 11] >= 0 {
        pool.give(contents(core.pendpool), st[p + 11]);
        st[p + 11] = 0 - 1;
    }
    if st[p + 12] >= 0 {
        pool.give(contents(core.qpool), st[p + 12]);
        st[p + 12] = 0 - 1;
    }
    return 0;
}

fn shut[&t, &c](tab: &!t conns.Table, core: &!c Core, k: int) -> [] int {
    let st = contents(core.state);
    conns.close(tab, k);
    // A value that was arriving is given up.
    if st[stride() * k + 13] != 0 && st[stride() * k + 13] != 4 && st[stride() * k + 14] >= 0 && st[stride() * k + 17] == store.epoch_of(core.store) {
        store.abort(core.store, st[stride() * k + 14]);
    }
    st[stride() * k + 13] = 0;
    return_blocks(core, k);
    st[stride() * k + 1] = 0;
    return 0;
}

// Watch `k` for what it now waits on: room to write if output is queued (and read no more), input otherwise.
fn settle[&t, &c](tab: &!t conns.Table, core: &!c Core, k: int) -> [poll] int {
    let st = contents(core.state);
    let p = stride() * k;
    var want = 1;
    if st[p + 2] > 0 || st[p + 13] == 4 {
        want = 2;
    }
    if want != st[p + 4] {
        conns.rewatch(tab, core.poller, k, k + 1, want);
        st[p + 4] = want;
    }
    return 0;
}

// Send the value of the entry connection `k` is sending (mode 4), a piece at a time while the kernel takes them, and at most `send_turn()` bytes in one go, so
// that one big value does not hold up the others: when it stops with the mode still 4 and nothing waiting, the connection is watched for room to write and
// comes back. If the value has been written since it began to go (or the keys were flushed) the answer cannot be finished and the connection is closed.
fn send_turn() -> [] int {
    return 262144;
}

fn pump_get[&t, &c](tab: &!t conns.Table, core: &!c Core, k: int, ops: int, ope: int) -> [conn_write] int {
    let st = contents(core.state);
    let pd = contents(core.pends);
    let p = stride() * k;
    var budget = send_turn();
    while st[p + 13] == 4 && st[p + 2] == 0 && budget > 0 {
        let e = st[p + 14];
        if st[p + 17] != store.epoch_of(core.store) || !store.unchanged(core.store, e, st[p + 16]) {
            st[p + 2] = 0 - 1;
            st[p + 13] = 0;
        } else {
            let total = len(store.value(core.store, e));
            var c = total - st[p + 15];
            if c > flush_at() {
                c = flush_at();
            }
            if c > 0 {
                st[p + 2] = emit(tab, k, store.value(core.store, e)[st[p + 15]..st[p + 15] + c], pd[ops..ope], st[p + 2]);
            }
            st[p + 15] = st[p + 15] + c;
            budget = budget - c - 1;
            if st[p + 15] >= total && st[p + 2] >= 0 {
                st[p + 2] = emit(tab, k, "\r\n", pd[ops..ope], st[p + 2]);
                st[p + 13] = 0;
            }
        }
    }
    return 0;
}

// Answer every whole command buffered for connection `k`, write the answers, and keep the start of one that
// is still arriving. Closes the connection if it is to close, or cannot be written to.
fn process[&t, &c](tab: &!t conns.Table, core: &!c Core, k: int) -> [conn_write, poll] int {
    let st = contents(core.state);
    let bf = contents(core.bufs);
    let pd = contents(core.pends);
    let sc = contents(core.scratch);
    let tb = contents(core.table);
    let tall = contents(core.txns);
    let qall = contents(core.queues);
    let size = input_size();
    let p = stride() * k;
    // The input is in the block the connection holds, or, if it holds none, in the shared one the read went into.
    var cur = st[p + 10];
    if cur < 0 {
        cur = input_blocks();
    }
    let base = cur * size;
    // A block for the answers the kernel may not take. If there is none to lend, the answers are still offered to the kernel and the connection
    // is closed only if it does not take them all.
    if st[p + 11] < 0 && st[p + 2] == 0 {
        st[p + 11] = pool.take(contents(core.pendpool));
    }
    var ops = 0;
    var ope = 0;
    if st[p + 11] >= 0 {
        ops = st[p + 11] * output_size();
        ope = ops + output_size();
    }
    var used = 0;
    var at = 0;
    var going = true;
    while going {
        // A value that is being sent goes first, and the commands after it wait for it.
        if st[p + 13] == 4 && st[p + 2] == 0 && st[p + 3] == 0 {
            if at > 0 {
                st[p + 2] = emit(tab, k, sc[0..at], pd[ops..ope], st[p + 2]);
                at = 0;
            }
            if st[p + 2] == 0 {
                pump_get(tab, core, k, ops, ope);
            }
        }
        if st[p + 2] != 0 || st[p + 3] != 0 || st[p + 13] == 4 || used >= st[p] {
            going = false;
        } else if st[p + 13] == 1 {
            // The bytes of a value that is arriving: into the record reserved for it, or nowhere.
            var take = st[p] - used;
            if take > st[p + 15] {
                take = st[p + 15];
            }
            if st[p + 14] >= 0 && st[p + 17] != store.epoch_of(core.store) {
                // The keys were flushed under it; the record is gone.
                st[p + 14] = 0 - 1;
                at = reply.put(sc, at, "-ERR the keys were flushed while the value was arriving\r\n");
            }
            if st[p + 14] >= 0 {
                store.fill(core.store, st[p + 14], store.staged_size(core.store, st[p + 14]) - st[p + 15], bf[base + used..base + used + take]);
            }
            st[p + 15] = st[p + 15] - take;
            used = used + take;
            if st[p + 15] == 0 {
                st[p + 13] = 3;
            }
        } else if st[p + 13] == 3 {
            // The CRLF after the value; then the command is done.
            if st[p] - used < 2 {
                going = false;
            } else if int_of(bf[base + used]) != '\r' || int_of(bf[base + used + 1]) != '\n' {
                if st[p + 14] >= 0 && st[p + 17] == store.epoch_of(core.store) {
                    store.abort(core.store, st[p + 14]);
                }
                st[p + 13] = 0;
                at = reply.put(sc, at, "-ERR Protocol error: expected CRLF after bulk\r\n");
                st[p + 3] = 1;
                going = false;
            } else {
                used = used + 2;
                if st[p + 14] >= 0 {
                    if st[p + 17] == store.epoch_of(core.store) {
                        at = stream.finish(sc, at, core.store, st[p + 14], st[p + 16]);
                    } else {
                        at = reply.put(sc, at, "-ERR the keys were flushed while the value was arriving\r\n");
                    }
                }
                st[p + 13] = 0;
                contents(core.info)[2] = contents(core.info)[2] + 1;
                if at >= flush_at() || at + commands.reserve() > len(sc) {
                    st[p + 2] = emit(tab, k, sc[0..at], pd[ops..ope], st[p + 2]);
                    at = 0;
                }
            }
        } else {
            let view = bf[base + used..base + st[p]];
            var n = resp.parse(view, tb);
            if n == resp.streaming() {
                // The last argument is too long for a block: `SET` and `SETEX` take it in pieces, nothing else does.
                if !stream.can(view, tb) {
                    at = reply.put(sc, at, "-ERR Protocol error: command too large\r\n");
                    st[p + 3] = 1;
                    going = false;
                } else {
                    let last = tb[0] - 1;
                    let vstart = tb[1 + 2 * last];
                    let vlen = tb[2 + 2 * last];
                    let tx = tall[txn.stride() * k..txn.stride() * k + txn.stride()];
                    var entry = 0 - 1;
                    var expiry = 0;
                    if tx[0] == 1 {
                        // It cannot be queued: the same as a command that does not fit the queue.
                        tx[1] = 1;
                        at = reply.put(sc, at, "-ERR transaction queue is full\r\n");
                    } else {
                        let (after, e2, x2) = stream.begin(view, tb, sc, at, core.store);
                        at = after;
                        entry = e2;
                        expiry = x2;
                    }
                    st[p + 13] = 1;
                    st[p + 14] = entry;
                    st[p + 15] = vlen;
                    st[p + 16] = expiry;
                    st[p + 17] = store.epoch_of(core.store);
                    used = used + vstart;
                }
            } else if n == 0 {
                if used == 0 && st[p] >= size {
                    at = reply.put(sc, at, "-ERR Protocol error: command too large\r\n");
                    st[p + 3] = 1;
                }
                going = false;
            } else if n < 0 {
                at = reply.put(sc, at, "-ERR ");
                at = reply.put(sc, at, resp.error_text(n));
                if n == resp.error_expected_bulk() {
                    at = reply.put_byte(sc, at, tb[0]);
                    at = reply.put(sc, at, "'");
                }
                at = reply.put(sc, at, "\r\n");
                st[p + 3] = 1;
                going = false;
            } else {
                // `MULTI` and its kin, and a command inside a transaction, are answered or queued by `txn`; everything else is run here.
                let tx = tall[txn.stride() * k..txn.stride() * k + txn.stride()];
                // A queue is lent from the first command after `MULTI`; if there is none to lend, the queue is full.
                if tx[0] == 1 && st[p + 12] < 0 {
                    st[p + 12] = pool.take(contents(core.qpool));
                }
                var qlo = 0;
                var qhi = 0;
                if st[p + 12] >= 0 {
                    qlo = st[p + 12] * size;
                    qhi = qlo + size;
                }
                let (after, status) = txn.handle(view, tb, sc, at, core.store, tx, qall[qlo..qhi], st[p + 5..p + 10], n);
                at = after;
                if status == 0 {
                    // A `GET` of a value too long for a buffer is sent in pieces.
                    let (after, ge) = stream.get_begin(view, tb, sc, at, core.store);
                    if ge >= 0 {
                        at = after;
                        st[p + 13] = 4;
                        st[p + 14] = ge;
                        st[p + 15] = 0;
                        st[p + 16] = store.stamp_of(core.store, ge);
                        st[p + 17] = store.epoch_of(core.store);
                    } else {
                        at = commands.execute(view, tb, sc, at, core.store, contents(core.tmp), st[p + 5..p + 10], contents(core.names)[k * 64..k * 64 + 64], contents(core.info));
                    }
                }
                if status == 0 && st[p + 9] != 0 {
                    // A command that answers in pieces (`MGET`) wrote one and has more to say. What it wrote goes out now; the command stays
                    // where it is in the input, and when the answers have gone (this turn, or the one the socket can take more in) it is parsed
                    // again and goes on from where `st[p + 9]` says.
                    st[p + 2] = emit(tab, k, sc[0..at], pd[ops..ope], st[p + 2]);
                    at = 0;
                    n = 0;
                } else {
                    contents(core.info)[2] = contents(core.info)[2] + 1;
                }
                if status == 2 {
                    // `EXEC`: run what was queued, one command at a time, the answers going out as they fill. If the client is not reading and the
                    // answers cannot all be sent, it stops where it is (`tx[22]`, `tx[23]`), stays at the `EXEC` in the input, and goes on when the
                    // socket can take more: the same way a command that answers in pieces does. While it waits, other connections' commands run,
                    // so an `EXEC` that has to wait for its client is no longer atomic with them; one that does not wait still is.
                    let queue = qall[qlo..qhi];
                    var qi = tx[23];
                    var running = true;
                    while running && qi < tx[2] {
                        let qview = queue[qi..tx[2]];
                        let qn = resp.parse(qview, tb);
                        if qn <= 0 {
                            qi = tx[2];
                        } else {
                            var done = true;
                            if reply.is_word(reply.arg_of(qview, tb, 0), "UNWATCH") {
                                // The watches were checked already and `clear` below forgets them.
                                at = reply.put(sc, at, "+OK\r\n");
                            } else {
                                at = commands.execute(qview, tb, sc, at, core.store, contents(core.tmp), st[p + 5..p + 10], contents(core.names)[k * 64..k * 64 + 64], contents(core.info));
                                if st[p + 9] != 0 {
                                    // Part way through a command that answers in pieces: what it wrote goes out, and it is called again.
                                    st[p + 2] = emit(tab, k, sc[0..at], pd[ops..ope], st[p + 2]);
                                    at = 0;
                                    done = false;
                                    if st[p + 2] != 0 {
                                        running = false;
                                    }
                                }
                            }
                            if done {
                                qi = qi + qn;
                                if at >= flush_at() || at + commands.reserve() > len(sc) {
                                    st[p + 2] = emit(tab, k, sc[0..at], pd[ops..ope], st[p + 2]);
                                    at = 0;
                                    if st[p + 2] != 0 {
                                        running = false;
                                    }
                                }
                            }
                        }
                    }
                    if qi < tx[2] && st[p + 2] > 0 {
                        tx[22] = 1;
                        tx[23] = qi;
                        n = 0;
                    } else {
                        txn.clear(tx);
                    }
                }
                if st[p + 7] == 1 {
                    st[p + 3] = 1;
                    going = false;
                }
                used = used + n;
                // Room for the biggest answer one command can make, and no more than the queue for a slow client can take at once: once
                // that much is waiting the loop stops, leaving the commands after it in the input until the client has read.
                if at >= flush_at() || at + commands.reserve() > len(sc) {
                    st[p + 2] = emit(tab, k, sc[0..at], pd[ops..ope], st[p + 2]);
                    at = 0;
                }
            }
        }
    }
    if at > 0 && st[p + 2] >= 0 {
        st[p + 2] = emit(tab, k, sc[0..at], pd[ops..ope], st[p + 2]);
    }
    if st[p + 2] < 0 {
        shut(tab, core, k);
        return 0;
    }
    var at_front = 0;
    while at_front < st[p] - used {
        bf[base + at_front] = bf[base + used + at_front];
        at_front = at_front + 1;
    }
    st[p] = st[p] - used;
    // A transaction that is over gives its queue back.
    if st[p + 12] >= 0 && tall[txn.stride() * k] == 0 && tall[txn.stride() * k + 22] == 0 {
        pool.give(contents(core.qpool), st[p + 12]);
        st[p + 12] = 0 - 1;
    }
    if st[p + 3] == 1 && st[p + 2] == 0 {
        shut(tab, core, k);
        return 0;
    }
    // The input left over: kept in a block of the connection's own, which the shared block cannot be; and a block that is no longer needed goes back.
    if cur == input_blocks() {
        if st[p] > 0 {
            let b = pool.take(contents(core.inpool));
            if b < 0 {
                // Nowhere to keep the part of a command that has arrived.
                shut(tab, core, k);
                return 0;
            }
            var i = 0;
            while i < st[p] {
                bf[b * size + i] = bf[base + i];
                i = i + 1;
            }
            st[p + 10] = b;
        }
    } else if st[p] == 0 {
        pool.give(contents(core.inpool), cur);
        st[p + 10] = 0 - 1;
    }
    if st[p + 2] == 0 && st[p + 11] >= 0 {
        pool.give(contents(core.pendpool), st[p + 11]);
        st[p + 11] = 0 - 1;
    }
    settle(tab, core, k);
    return 0;
}

// The poller said connection `k` is ready.
fn step[&t, &c](tab: &!t conns.Table, core: &!c Core, k: int, readiness: int) -> [conn_read, conn_write, poll] int {
    let st = contents(core.state);
    let bf = contents(core.bufs);
    let pd = contents(core.pends);
    let size = input_size();
    let p = stride() * k;
    var cur = st[p + 10];
    if cur < 0 {
        cur = input_blocks();
    }
    let base = cur * size;
    if st[p + 2] > 0 && st[p + 11] < 0 {
        // Output waiting and nowhere it is kept: cannot be, and a connection in that state is of no use.
        shut(tab, core, k);
        return 0;
    }
    let obase = st[p + 11] * output_size();
    if st[p + 13] == 4 && st[p + 2] == 0 {
        // A value is being sent and the last of it went: the connection is watched for room to write, and has some.
        if readiness % 4 >= 2 {
            process(tab, core, k);
        } else if readiness % 2 == 1 {
            shut(tab, core, k);
        }
        return 0;
    }
    if st[p + 2] > 0 {
        // Waiting to send: the kernel can take more.
        if readiness % 4 >= 2 {
            match conns.write(tab, k, pd[obase..obase + st[p + 2]]) {
                Sent::Wrote(sent) => {
                    var at = 0;
                    while at < st[p + 2] - sent {
                        pd[obase + at] = pd[obase + sent + at];
                        at = at + 1;
                    }
                    st[p + 2] = st[p + 2] - sent;
                    if st[p + 2] == 0 {
                        if st[p + 3] == 1 {
                            shut(tab, core, k);
                        } else {
                            // Held back while the last answers were being sent.
                            pool.give(contents(core.pendpool), st[p + 11]);
                            st[p + 11] = 0 - 1;
                            process(tab, core, k);
                        }
                    }
                }
                Sent::Again => {
                }
                Sent::Failed(e) => {
                    shut(tab, core, k);
                }
            }
        } else if readiness % 2 == 1 {
            // The peer has gone, or said something while we are not listening.
            shut(tab, core, k);
        }
    } else if st[p] >= size {
        // No room to read into and nothing to send: a command that can never fit was answered already.
        shut(tab, core, k);
    } else {
        match conns.read(tab, k, bf[base + st[p]..base + size]) {
            Received::Data(got) => {
                st[p] = st[p] + got;
                process(tab, core, k);
            }
            Received::End => {
                shut(tab, core, k);
            }
            Received::Again => {
            }
            Received::Failed(e) => {
                shut(tab, core, k);
            }
        }
    }
    return 0;
}

// Take every connection waiting on the listener, up to the limit: each goes in the table, is made
// non-blocking, and is watched for input under the token `slot + 1` (the listener is token 0).
fn accept_all[&h, &l, &c](heap: &!h Heap, conn: conns.Table, listener: &!l Listener, core: &!c Core) -> [heap, conn_accept, poll] conns.Table {
    let st = contents(core.state);
    var table = conn;
    var more = true;
    while more {
        match tcp_accept(listener) {
            Accepted::Ok(c) => {
                var held = 0;
                borrow table as &tt in {
                    held = conns.live(tt);
                }
                if held >= max_connections() {
                    conn_close(c);
                } else {
                    let (grown, slot) = conns.put(heap, table, c);
                    table = grown;
                    if slot >= 0 {
                        let p = stride() * slot;
                        st[p] = 0;
                        st[p + 1] = 1;
                        st[p + 2] = 0;
                        st[p + 3] = 0;
                        st[p + 4] = 1;
                        st[p + 5] = 0;
                        // Client ids count from 1, as Redis's do; `info[5]` is the next.
                        contents(core.info)[5] = contents(core.info)[5] + 1;
                        st[p + 6] = contents(core.info)[5];
                        st[p + 7] = 0;
                        st[p + 8] = 2;
                        st[p + 9] = 0;
                        st[p + 10] = 0 - 1;
                        st[p + 11] = 0 - 1;
                        st[p + 12] = 0 - 1;
                        st[p + 13] = 0;
                        txn.clear(contents(core.txns)[txn.stride() * slot..txn.stride() * slot + txn.stride()]);
                        contents(core.info)[3] = contents(core.info)[3] + 1;
                        borrow mut table as &!ct in {
                            if conns.nonblocking(ct, slot) != 0 || conns.watch(ct, core.poller, slot, slot + 1, 1) != 0 {
                                shut(ct, core, slot);
                            }
                        }
                    }
                }
            }
            Accepted::Again => {
                more = false;
            }
            Accepted::Failed(e) => {
                more = false;
            }
        }
    }
    return table;
}

// ---------------------------------------------------------------------
// The loop
// ---------------------------------------------------------------------

fn run[&h, &l, &k](heap: &!h Heap, listener: &!l Listener, clock: &k Clock, port: int, memory: int, max_keys: int, policy: int, seed: int) -> [heap, conn_accept, conn_read, conn_write, poll, clock] int {
    match poller_new() {
        Polling::Ok(p) => {
            var poller = p;
            borrow mut poller as &!pw in {
                poller_add_listener(pw, listener, 0);
            }
            let limit = max_connections();
            var core = Core { poller: poller, events: box_slice(heap, 128, 0), state: box_slice(heap, stride() * limit, 0), bufs: box_slice(heap, (input_blocks() + 1) * input_size(), byte_of(0)), pends: box_slice(heap, pend_blocks() * output_size(), byte_of(0)), inpool: box_slice(heap, input_blocks() + 1, 0), pendpool: box_slice(heap, pend_blocks() + 1, 0), qpool: box_slice(heap, queue_blocks() + 1, 0), table: box_slice(heap, resp.slots(), 0), scratch: box_slice(heap, 3 * commands.reserve(), byte_of(0)), tmp: box_slice(heap, 64, byte_of(0)), names: box_slice(heap, limit * 64, byte_of(0)), info: box_slice(heap, 8, 0), txns: box_slice(heap, txn.stride() * limit, 0), queues: box_slice(heap, queue_blocks() * input_size(), byte_of(0)), store: store.open(heap, memory, max_keys, seed, policy), swept: 0 };
            var tab = conns.empty(heap, 64);
            borrow mut core as &!cw in {
                pool.fill(contents(cw.inpool));
                pool.fill(contents(cw.pendpool));
                pool.fill(contents(cw.qpool));
                store.tick(cw.store, clock_ms(clock));
                contents(cw.info)[1] = store.now_of(cw.store);
                contents(cw.info)[4] = port;
            }
            while true {
                var ready = 0 - 1;
                borrow mut core as &!cw in {
                    // Wake often enough to take keys whose time has come, but only if there are any.
                    var wait_ms = 1000;
                    if store.keys_with_expiry(cw.store) > 0 {
                        wait_ms = 100;
                    }
                    // A compaction part way through is finished while the cache is idle, a slice a turn.
                    if store.compacting(cw.store) {
                        wait_ms = 0;
                    }
                    ready = poller_wait(cw.poller, contents(cw.events), wait_ms);
                    // The time, once for this turn: every use of a key in it is stamped with it.
                    store.tick(cw.store, clock_ms(clock));
                }
                // The turn's own time, not the wait before it: the longest one is what `INFO` reports as `max_turn_ms`.
                let turn_start = clock_ms(clock);
                var j = 0;
                while j < ready {
                    var token = 0 - 1;
                    var readiness = 0;
                    borrow core as &cr in {
                        token = contents(cr.events)[2 * j];
                        readiness = contents(cr.events)[2 * j + 1];
                    }
                    if token == 0 {
                        borrow mut core as &!cw in {
                            tab = accept_all(heap, tab, listener, cw);
                        }
                    } else {
                        borrow mut tab as &!tw in {
                            borrow mut core as &!cw in {
                                if contents(cw.state)[stride() * (token - 1) + 1] == 1 {
                                    step(tw, cw, token - 1, readiness);
                                }
                            }
                        }
                    }
                    j = j + 1;
                }
                borrow mut core as &!cw in {
                    borrow tab as &tr in {
                        contents(cw.info)[0] = conns.live(tr);
                    }
                    // Work the arena's reclaiming ahead of need, a slice at a time (the sets do some themselves).
                    store.reclaim(cw.store, 1024);
                    // Take the keys whose time has passed that nobody asked for again: at most a hundred times a second,
                    // 256 keys at a look, and again while more than a quarter of what it looked at had run out (Redis's
                    // rule), at most sixteen looks.
                    let took = clock_ms(clock) - turn_start;
                    if took > contents(cw.info)[6] {
                        contents(cw.info)[6] = took;
                    }
                    if store.now_of(cw.store) - cw.swept >= 10 {
                        cw.swept = store.now_of(cw.store);
                        var looks = 0;
                        var more = true;
                        while more && looks < 16 {
                            more = store.sweep(cw.store, 256) * 4 > 256;
                            looks = looks + 1;
                        }
                    }
                }
            }
            conns.drop(heap, tab);
            let Core { poller, events, state, bufs, pends, inpool, pendpool, qpool, table, scratch, tmp, names, info, txns, queues, store, swept } = core;
            poller_close(poller);
            unbox_slice(heap, events);
            unbox_slice(heap, state);
            unbox_slice(heap, bufs);
            unbox_slice(heap, pends);
            unbox_slice(heap, inpool);
            unbox_slice(heap, pendpool);
            unbox_slice(heap, qpool);
            unbox_slice(heap, table);
            unbox_slice(heap, scratch);
            unbox_slice(heap, tmp);
            unbox_slice(heap, names);
            unbox_slice(heap, info);
            unbox_slice(heap, txns);
            unbox_slice(heap, queues);
            store.close(heap, store);
            return 0;
        }
        Polling::Failed(e) => {
            return 4;
        }
    }
}

fn number_of[&t](text: &t [byte]) -> [] int {
    if len(text) == 0 || len(text) > 9 {
        return 0 - 1;
    }
    var n = 0;
    var i = 0;
    while i < len(text) {
        let c = int_of(text[i]);
        if c < '0' || c > '9' {
            return 0 - 1;
        }
        n = n * 10 + (c - '0');
        i = i + 1;
    }
    return n;
}

// The seed the server hashes keys with: eight bytes of the OS entropy (issue #12). 0, the old
// constant, if `/dev/urandom` cannot be read, so a host without one still starts.
fn seed_from[&f](fs: &f Fs("/dev/urandom")) -> [fs_read("/dev/urandom")] int {
    region a {
        let raw = alloc_slice[a](8, byte_of(0));
        let got = fs_read(fs, "/dev/urandom", raw);
        if got != 8 {
            return 0;
        }
        var n = 0;
        var i = 7;
        while i >= 0 {
            n = n << 8 | int_of(raw[i]) & 0xff;
            i = i - 1;
        }
        return n;
    }
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock } = split(world);
    release(ffi);
    var port = 0 - 1;
    borrow args as &g in {
        if arg_count(g) > 1 {
            port = number_of(arg(g, 1));
        }
    }
    var megabytes = 64;
    var max_keys = 1000000;
    var policy = store.evict_none();
    var seed = 0 - 1;
    borrow args as &g in {
        if arg_count(g) > 4 {
            if arg(g, 4)[0] == byte_of('a') {
                policy = store.evict_lru();
            }
        }
        if arg_count(g) > 2 {
            megabytes = number_of(arg(g, 2));
        }
        if arg_count(g) > 3 {
            max_keys = number_of(arg(g, 3));
        }
        if arg_count(g) > 5 {
            seed = number_of(arg(g, 5));
        }
    }
    let rnd = narrow(fs, "/dev/urandom");
    if seed < 0 {
        borrow rnd as &f in {
            seed = seed_from(f);
        }
    }
    release(rnd);
    var status = 2;
    if port > 0 && port < 65536 && megabytes > 0 && megabytes <= 4096 && max_keys > 0 && max_keys <= 100000000 {
        status = 3;
        borrow net as &nn in {
            match tcp_listen(nn, port, 1024, 0) {
                Listening::Ok(l) => {
                    var listener = l;
                    borrow mut listener as &!lh in {
                        listener_nonblocking(lh);
                        borrow mut heap as &!h in {
                            borrow mut io as &!i in {
                                var line = buffer.append(h, buffer.empty(h, 64), "listening on ");
                                line = buffer.push_nat(h, line, port);
                                line = buffer.push(h, line, byte_of(10));
                                borrow line as &lb in {
                                    io.error_all(i, buffer.bytes(lb));
                                }
                                buffer.drop(h, line);
                            }
                            borrow clock as &c in {
                                status = run(h, lh, c, port, megabytes * 1048576, max_keys, policy, seed);
                            }
                        }
                    }
                    listener_close(listener);
                }
                Listening::Failed(e) => {
                }
            }
        }
    }
    release(net);
    release(clock);
    release(args);
    release(io);
    release(heap);
    return status;
}
