// What `COMMAND GETKEYS` needs of a command: `(known, arity, first key, last key, step)` as Redis 7.0 gives them. `sub` is the subcommand word of a
// container command (`OBJECT ENCODING`), and is only read for those; an unknown name or subcommand is `(false, 0, 0, 0, 0)`.
pub fn key_spec[&w, &s](name: &w [byte], sub: &s [byte]) -> [] (bool, int, int, int, int) {
    if reply.is_word(name, "APPEND") {
        return (true, 3, 1, 1, 1);
    }
    if reply.is_word(name, "AUTH") {
        return (true, -2, 0, 0, 0);
    }
    if reply.is_word(name, "CLIENT") {
        if reply.is_word(sub, "CACHING") {
            return (true, 3, 0, 0, 0);
        }
        if reply.is_word(sub, "GETNAME") {
            return (true, 2, 0, 0, 0);
        }
        if reply.is_word(sub, "GETREDIR") {
            return (true, 2, 0, 0, 0);
        }
        if reply.is_word(sub, "HELP") {
            return (true, 2, 0, 0, 0);
        }
        if reply.is_word(sub, "ID") {
            return (true, 2, 0, 0, 0);
        }
        if reply.is_word(sub, "INFO") {
            return (true, 2, 0, 0, 0);
        }
        if reply.is_word(sub, "KILL") {
            return (true, -3, 0, 0, 0);
        }
        if reply.is_word(sub, "LIST") {
            return (true, -2, 0, 0, 0);
        }
        if reply.is_word(sub, "NO-EVICT") {
            return (true, 3, 0, 0, 0);
        }
        if reply.is_word(sub, "PAUSE") {
            return (true, -3, 0, 0, 0);
        }
        if reply.is_word(sub, "REPLY") {
            return (true, 3, 0, 0, 0);
        }
        if reply.is_word(sub, "SETNAME") {
            return (true, 3, 0, 0, 0);
        }
        if reply.is_word(sub, "TRACKING") {
            return (true, -3, 0, 0, 0);
        }
        if reply.is_word(sub, "TRACKINGINFO") {
            return (true, 2, 0, 0, 0);
        }
        if reply.is_word(sub, "UNBLOCK") {
            return (true, -3, 0, 0, 0);
        }
        if reply.is_word(sub, "UNPAUSE") {
            return (true, 2, 0, 0, 0);
        }
        return (false, 0, 0, 0, 0);
    }
    if reply.is_word(name, "COMMAND") {
        if reply.is_word(sub, "COUNT") {
            return (true, 2, 0, 0, 0);
        }
        if reply.is_word(sub, "DOCS") {
            return (true, -2, 0, 0, 0);
        }
        if reply.is_word(sub, "GETKEYS") {
            return (true, -4, 0, 0, 0);
        }
        if reply.is_word(sub, "GETKEYSANDFLAGS") {
            return (true, -4, 0, 0, 0);
        }
        if reply.is_word(sub, "HELP") {
            return (true, 2, 0, 0, 0);
        }
        if reply.is_word(sub, "INFO") {
            return (true, -2, 0, 0, 0);
        }
        if reply.is_word(sub, "LIST") {
            return (true, -2, 0, 0, 0);
        }
        return (false, 0, 0, 0, 0);
    }
    if reply.is_word(name, "CONFIG") {
        if reply.is_word(sub, "GET") {
            return (true, -3, 0, 0, 0);
        }
        if reply.is_word(sub, "HELP") {
            return (true, 2, 0, 0, 0);
        }
        if reply.is_word(sub, "RESETSTAT") {
            return (true, 2, 0, 0, 0);
        }
        if reply.is_word(sub, "REWRITE") {
            return (true, 2, 0, 0, 0);
        }
        if reply.is_word(sub, "SET") {
            return (true, -4, 0, 0, 0);
        }
        return (false, 0, 0, 0, 0);
    }
    if reply.is_word(name, "COPY") {
        return (true, -3, 1, 2, 1);
    }
    if reply.is_word(name, "DBSIZE") {
        return (true, 1, 0, 0, 0);
    }
    if reply.is_word(name, "DECR") {
        return (true, 2, 1, 1, 1);
    }
    if reply.is_word(name, "DECRBY") {
        return (true, 3, 1, 1, 1);
    }
    if reply.is_word(name, "DEL") {
        return (true, -2, 1, -1, 1);
    }
    if reply.is_word(name, "DISCARD") {
        return (true, 1, 0, 0, 0);
    }
    if reply.is_word(name, "ECHO") {
        return (true, 2, 0, 0, 0);
    }
    if reply.is_word(name, "EXEC") {
        return (true, 1, 0, 0, 0);
    }
    if reply.is_word(name, "EXISTS") {
        return (true, -2, 1, -1, 1);
    }
    if reply.is_word(name, "EXPIRE") {
        return (true, -3, 1, 1, 1);
