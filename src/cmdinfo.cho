    }
    if reply.is_word(name, "PING") {
        return true;
    }
    if reply.is_word(name, "PSETEX") {
        return true;
    }
    if reply.is_word(name, "PTTL") {
        return true;
    }
    if reply.is_word(name, "QUIT") {
        return true;
    }
    if reply.is_word(name, "RANDOMKEY") {
        return true;
    }
    if reply.is_word(name, "RENAME") {
        return true;
    }
    if reply.is_word(name, "RENAMENX") {
        return true;
    }
    if reply.is_word(name, "RESET") {
        return true;
    }
    if reply.is_word(name, "SCAN") {
        return true;
    }
    if reply.is_word(name, "SELECT") {
        return true;
    }
    if reply.is_word(name, "SET") {
        return true;
    }
    if reply.is_word(name, "SETEX") {
        return true;
    }
    if reply.is_word(name, "SETNX") {
        return true;
    }
    if reply.is_word(name, "SETRANGE") {
        return true;
    }
    if reply.is_word(name, "STRLEN") {
        return true;
    }
    if reply.is_word(name, "SUBSTR") {
        return true;
    }
    if reply.is_word(name, "TOUCH") {
        return true;
    }
    if reply.is_word(name, "TTL") {
        return true;
    }
    if reply.is_word(name, "TYPE") {
        return true;
    }
    if reply.is_word(name, "UNLINK") {
        return true;
    }
    if reply.is_word(name, "UNWATCH") {
        return true;
    }
    if reply.is_word(name, "WATCH") {
        return true;
    }
    return false;
}

