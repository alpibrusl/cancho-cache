    if reply.is_word(name, "EXPIRETIME") {
        return (true, 2, 1, 1, 1);
    }
    if reply.is_word(name, "FLUSHALL") {
        return (true, -1, 0, 0, 0);
    }
    if reply.is_word(name, "FLUSHDB") {
        return (true, -1, 0, 0, 0);
    }
    if reply.is_word(name, "GET") {
        return (true, 2, 1, 1, 1);
    }
    if reply.is_word(name, "GETDEL") {
        return (true, 2, 1, 1, 1);
    }
    if reply.is_word(name, "GETEX") {
        return (true, -2, 1, 1, 1);
    }
    if reply.is_word(name, "GETRANGE") {
        return (true, 4, 1, 1, 1);
    }
    if reply.is_word(name, "GETSET") {
        return (true, 3, 1, 1, 1);
    }
    if reply.is_word(name, "HDEL") {
        return (true, -3, 1, 1, 1);
    }
    if reply.is_word(name, "HELLO") {
        return (true, -1, 0, 0, 0);
    }
    if reply.is_word(name, "HEXISTS") {
        return (true, 3, 1, 1, 1);
    }
    if reply.is_word(name, "HGET") {
        return (true, 3, 1, 1, 1);
    }
    if reply.is_word(name, "HGETALL") {
        return (true, 2, 1, 1, 1);
    }
    if reply.is_word(name, "HINCRBY") {
        return (true, 4, 1, 1, 1);
    }
    if reply.is_word(name, "HKEYS") {
        return (true, 2, 1, 1, 1);
    }
    if reply.is_word(name, "HLEN") {
        return (true, 2, 1, 1, 1);
    }
    if reply.is_word(name, "HMGET") {
        return (true, -3, 1, 1, 1);
    }
    if reply.is_word(name, "HMSET") {
        return (true, -4, 1, 1, 1);
    }
    if reply.is_word(name, "HRANDFIELD") {
