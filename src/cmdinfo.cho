// Every entry, one after another (`COMMAND` and `COMMAND INFO` with no names).
pub fn put_all[&b](sc: &!b [byte], at: int, resp3: bool) -> [] int {
    var o = at;
    o = put_entry("APPEND", sc, o, resp3).1;
    o = put_entry("AUTH", sc, o, resp3).1;
    o = put_entry("CLIENT", sc, o, resp3).1;
    o = put_entry("COMMAND", sc, o, resp3).1;
    o = put_entry("CONFIG", sc, o, resp3).1;
    o = put_entry("COPY", sc, o, resp3).1;
    o = put_entry("DBSIZE", sc, o, resp3).1;
