        return (true, 2, 1, 1, 1);
    }
    if reply.is_word(name, "INCR") {
        return (true, 2, 1, 1, 1);
    }
    if reply.is_word(name, "INCRBY") {
        return (true, 3, 1, 1, 1);
    }
    if reply.is_word(name, "INFO") {
        return (true, -1, 0, 0, 0);
    }
    if reply.is_word(name, "KEYS") {
        return (true, 2, 0, 0, 0);
    }
    if reply.is_word(name, "MGET") {
        return (true, -2, 1, -1, 1);
    }
    if reply.is_word(name, "MSET") {
        return (true, -3, 1, -1, 2);
    }
    if reply.is_word(name, "MSETNX") {
        return (true, -3, 1, -1, 2);
    }
    if reply.is_word(name, "MULTI") {
        return (true, 1, 0, 0, 0);
    }
    if reply.is_word(name, "OBJECT") {
        if reply.is_word(sub, "ENCODING") {
            return (true, 3, 2, 2, 1);
        }
        if reply.is_word(sub, "FREQ") {
            return (true, 3, 2, 2, 1);
        }
        if reply.is_word(sub, "HELP") {
            return (true, 2, 0, 0, 0);
        }
        if reply.is_word(sub, "IDLETIME") {
            return (true, 3, 2, 2, 1);
        }
        if reply.is_word(sub, "REFCOUNT") {
            return (true, 3, 2, 2, 1);
        }
        return (false, 0, 0, 0, 0);
    }
    if reply.is_word(name, "PERSIST") {
        return (true, 2, 1, 1, 1);
    }
    if reply.is_word(name, "PEXPIRE") {
        return (true, -3, 1, 1, 1);
    }
    if reply.is_word(name, "PEXPIREAT") {
        return (true, -3, 1, 1, 1);
    }
    if reply.is_word(name, "PEXPIRETIME") {
        return (true, 2, 1, 1, 1);
    }
    if reply.is_word(name, "PING") {
        return (true, -1, 0, 0, 0);
    }
    if reply.is_word(name, "PSETEX") {
        return (true, 4, 1, 1, 1);
    }
    if reply.is_word(name, "PTTL") {
        return (true, 2, 1, 1, 1);
    }
    if reply.is_word(name, "QUIT") {
        return (true, -1, 0, 0, 0);
    }
    if reply.is_word(name, "RANDOMKEY") {
        return (true, 1, 0, 0, 0);
    }
    if reply.is_word(name, "RENAME") {
        return (true, 3, 1, 2, 1);
    }
    if reply.is_word(name, "RENAMENX") {
        return (true, 3, 1, 2, 1);
    }
    if reply.is_word(name, "RESET") {
        return (true, 1, 0, 0, 0);
    }
    if reply.is_word(name, "SCAN") {
        return (true, -2, 0, 0, 0);
    }
    if reply.is_word(name, "SELECT") {
        return (true, 2, 0, 0, 0);
    }
    if reply.is_word(name, "SET") {
        return (true, -3, 1, 1, 1);
