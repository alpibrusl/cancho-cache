    if reply.is_word(name, "PEXPIREAT") {
        if n == 0 {
            return (1, 0, 1);
        }
    }
    if reply.is_word(name, "PEXPIRETIME") {
        if n == 0 {
            return (1, 0, 1);
        }
    }
    if reply.is_word(name, "PSETEX") {
        if n == 0 {
            return (1, 0, 1);
        }
    }
    if reply.is_word(name, "PTTL") {
        if n == 0 {
            return (1, 0, 1);
        }
    }
    if reply.is_word(name, "RENAME") {
        if n == 0 {
            return (1, 0, 1);
        }
        if n == 1 {
            return (2, 0, 1);
        }
    }
    if reply.is_word(name, "RENAMENX") {
        if n == 0 {
            return (1, 0, 1);
        }
        if n == 1 {
            return (2, 0, 1);
        }
    }
    if reply.is_word(name, "SET") {
        if n == 0 {
            return (1, 0, 1);
        }
    }
    if reply.is_word(name, "SETEX") {
        if n == 0 {
            return (1, 0, 1);
        }
    }
    if reply.is_word(name, "SETNX") {
        if n == 0 {
            return (1, 0, 1);
        }
    }
    if reply.is_word(name, "SETRANGE") {
        if n == 0 {
            return (1, 0, 1);
        }
    }
    if reply.is_word(name, "STRLEN") {
        if n == 0 {
            return (1, 0, 1);
        }
    }
    if reply.is_word(name, "SUBSTR") {
        if n == 0 {
            return (1, 0, 1);
        }
    }
    if reply.is_word(name, "TOUCH") {
        if n == 0 {
            return (1, -1, 1);
        }
    }
    if reply.is_word(name, "TTL") {
        if n == 0 {
            return (1, 0, 1);
        }
    }
    if reply.is_word(name, "TYPE") {
        if n == 0 {
            return (1, 0, 1);
        }
    }
    if reply.is_word(name, "UNLINK") {
        if n == 0 {
            return (1, -1, 1);
        }
    }
    if reply.is_word(name, "WATCH") {
        if n == 0 {
            return (1, -1, 1);
        }
    }
    return (0, 0, 0);
}

// The flags of the n-th key spec as Redis writes them: an array of statuses, or a set in RESP3.
pub fn put_spec_flags[&w, &s, &b](name: &w [byte], sub: &s [byte], n: int, sc: &!b [byte], at: int, resp3: bool) -> [] int {
    if reply.is_word(name, "APPEND") {
        if n == 0 {
            if resp3 {
                return reply.put(sc, at, "~2\r\n+RW\r\n+insert\r\n");
            }
            return reply.put(sc, at, "*2\r\n+RW\r\n+insert\r\n");
        }
    }
    if reply.is_word(name, "COPY") {
        if n == 0 {
            if resp3 {
                return reply.put(sc, at, "~2\r\n+RO\r\n+access\r\n");
