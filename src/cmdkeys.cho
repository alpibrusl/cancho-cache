                return reply.put(sc, at, "~2\r\n+RM\r\n+delete\r\n");
            }
            return reply.put(sc, at, "*2\r\n+RM\r\n+delete\r\n");
        }
    }
    if reply.is_word(name, "EXISTS") {
        if n == 0 {
            if resp3 {
