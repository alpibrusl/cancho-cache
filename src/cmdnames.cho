                return 45;
            }
        }
        if first == 'M' {
            if reply.is_word(name, "MONITOR") {
                return 48;
            }
        }
        if first == 'P' {
            if reply.is_word(name, "PERSIST") {
                return 53;
            }
            if reply.is_word(name, "PEXPIRE") {
                return 54;
            }
        }
        if first == 'S' {
            if reply.is_word(name, "SLOWLOG") {
                return 74;
            }
        }
        if first == 'U' {
            if reply.is_word(name, "UNWATCH") {
