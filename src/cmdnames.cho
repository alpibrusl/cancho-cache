            if reply.is_word(name, "HSET") {
                return 37;
            }
        }
        if first == 'I' {
            if reply.is_word(name, "INCR") {
                return 41;
            }
            if reply.is_word(name, "INFO") {
                return 43;
            }
        }
        if first == 'K' {
            if reply.is_word(name, "KEYS") {
                return 44;
            }
        }
        if first == 'M' {
            if reply.is_word(name, "MGET") {
                return 47;
            }
            if reply.is_word(name, "MSET") {
                return 49;
            }
        }
        if first == 'P' {
