edition 5;

module cmdnames;

// `cmdnames` -- the number of each command this cache implements, for the counters of `INFO commandstats` (`docs/design.md` section 30).
// GENERATED by `tests/gen_cmdinfo.py`; CI regenerates it and fails if it differs. Do not edit by hand.

import reply;

// The command's number in `0..count()`, for the counters of `INFO commandstats`: found from the length of the name and its first letter, so that a command is compared
// with the one or two that could be it, and not with all of them. -1 for a name that is not in the table.
pub fn index_of[&w](name: &w [byte]) -> [] int {
    if len(name) == 0 {
        return 0 - 1;
    }
    let first = reply.upper(int_of(name[0]));
    if len(name) == 3 {
        if first == 'D' {
            if reply.is_word(name, "DEL") {
                return 10;
            }
        }
        if first == 'G' {
            if reply.is_word(name, "GET") {
                return 20;
            }
        }
        if first == 'S' {
            if reply.is_word(name, "SET") {
                return 70;
            }
        }
        if first == 'T' {
            if reply.is_word(name, "TTL") {
                return 78;
            }
        }
    }
    if len(name) == 4 {
        if first == 'A' {
            if reply.is_word(name, "AUTH") {
                return 1;
            }
        }
        if first == 'C' {
            if reply.is_word(name, "COPY") {
                return 6;
            }
        }
        if first == 'D' {
            if reply.is_word(name, "DECR") {
                return 8;
            }
        }
        if first == 'E' {
            if reply.is_word(name, "ECHO") {
                return 12;
            }
            if reply.is_word(name, "EXEC") {
                return 13;
            }
        }
        if first == 'H' {
            if reply.is_word(name, "HDEL") {
                return 25;
