// Whether command `i` can take long enough to be worth timing by default for the slow log (`docs/design.md` section 31): the ones whose cost grows with the
// keys, the arguments or the bytes they touch. A single-key lookup is not one: it cannot take a millisecond.
pub fn may_be_slow(i: int) -> [] bool {
    if i < 0 {
        return false;
    }
    if i < 62 {
        return 6360943781766265 >> i & 1 == 1;
    }
    return 1361996 >> i - 62 & 1 == 1;
}

