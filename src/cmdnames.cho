    }
    if len(name) == 7 {
        if first == 'C' {
            if reply.is_word(name, "CLUSTER") {
                return 3;
            }
            if reply.is_word(name, "COMMAND") {
                return 4;
            }
        }
        if first == 'D' {
            if reply.is_word(name, "DISCARD") {
                return 11;
            }
        }
        if first == 'F' {
            if reply.is_word(name, "FLUSHDB") {
                return 19;
            }
        }
        if first == 'H' {
            if reply.is_word(name, "HEXISTS") {
                return 27;
            }
            if reply.is_word(name, "HGETALL") {
                return 29;
            }
            if reply.is_word(name, "HINCRBY") {
                return 30;
            }
            if reply.is_word(name, "HSTRLEN") {
