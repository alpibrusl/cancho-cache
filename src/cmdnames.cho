// Whether `MONITOR` leaves command `i` (with subcommand `sub`, if it has them) out of what it shows: Redis does not show the commands flagged `admin` (`CONFIG`, `SLOWLOG`,
// `CLIENT LIST`, ...), read from the oracle's `COMMAND INFO` (`docs/design.md` section 34).
pub fn skips_monitor[&w](i: int, sub: &w [byte]) -> [] bool {
    if i == 48 {
        return true;
    }
    if i == 67 {
        return true;
    }
    if i == 2 && (reply.is_word(sub, "KILL") || reply.is_word(sub, "LIST") || reply.is_word(sub, "NO-EVICT") || reply.is_word(sub, "PAUSE") || reply.is_word(sub, "UNBLOCK") || reply.is_word(sub, "UNPAUSE")) {
        return true;
    }
    if i == 3 && (reply.is_word(sub, "ADDSLOTS") || reply.is_word(sub, "ADDSLOTSRANGE") || reply.is_word(sub, "BUMPEPOCH") || reply.is_word(sub, "COUNT-FAILURE-REPORTS") || reply.is_word(sub, "DELSLOTS") || reply.is_word(sub, "DELSLOTSRANGE") || reply.is_word(sub, "FAILOVER") || reply.is_word(sub, "FLUSHSLOTS") || reply.is_word(sub, "FORGET") || reply.is_word(sub, "MEET") || reply.is_word(sub, "REPLICAS") || reply.is_word(sub, "REPLICATE") || reply.is_word(sub, "RESET") || reply.is_word(sub, "SAVECONFIG") || reply.is_word(sub, "SET-CONFIG-EPOCH") || reply.is_word(sub, "SETSLOT") || reply.is_word(sub, "SLAVES")) {
        return true;
    }
    if i == 5 && (reply.is_word(sub, "GET") || reply.is_word(sub, "RESETSTAT") || reply.is_word(sub, "REWRITE") || reply.is_word(sub, "SET")) {
        return true;
    }
    if i == 45 && (reply.is_word(sub, "DOCTOR") || reply.is_word(sub, "GRAPH") || reply.is_word(sub, "HISTOGRAM") || reply.is_word(sub, "HISTORY") || reply.is_word(sub, "LATEST") || reply.is_word(sub, "RESET")) {
        return true;
    }
    if i == 74 && (reply.is_word(sub, "GET") || reply.is_word(sub, "LEN") || reply.is_word(sub, "RESET")) {
        return true;
    }
    return false;
}
