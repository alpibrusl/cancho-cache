edition 5;

module commands;

import glob;
import reply;
import session;
import store;

// `commands` -- what each command means, over the store (`docs/design.md` §4). Redis is the oracle: the argument
// checks, the order they are made in, and the text of every error are Redis 7.0's, and `tests/differential.py` holds
// them to it byte for byte.
//
// `execute` answers one command into the scratch buffer `sc` from `at` and returns where the answer ends. It never
// traps and never writes more than `reserve()` bytes.
//
// Not here, and said so: the commands that name a time of day (`EXAT`, `PXAT`, `EXPIREAT`, `PEXPIREAT`), because the
// cache has a monotonic clock and no calendar; and everything that is not a string key (lists, hashes, sets, sorted
// sets, streams), which are non-goals.

// The most bytes the answer to one command can take: `MGET` of the most keys the parser allows, each value as large as
// a command can carry (the input buffer, 16 KiB), plus framing.
pub fn reserve() -> [] int {
    return 1114112;
}

// ---------------------------------------------------------------------
// The commands
// ---------------------------------------------------------------------

// When an expiry `amount` (in seconds if `seconds`, else milliseconds) from now is, in the store's milliseconds: `(0,
// when)`, or `(1, 0)` if the amount does not fit.
fn expire_at(amount: int, seconds: bool, now: int) -> [] (int, int) {
    var ms = amount;
    if seconds {
        if amount > reply.max_int() / 1000 || amount < reply.min_int() / 1000 {
            return (1, 0);
        }
        ms = amount * 1000;
    }
    if ms > reply.max_int() - now {
        return (1, 0);
    }
    return (0, ms + now);
}

// `SET key value [NX | XX] [GET] [EX seconds | PX milliseconds | KEEPTTL]`
fn command_set[&v, &t, &b, &s](view: &v [byte], table: &t [int], sc: &!b [byte], at: int, st: &!s store.Store, proto: int) -> [] int {
    let argc = table[0];
    var nx = false;
    var xx = false;
    var get = false;
    var keepttl = false;
    // 0 none, 1 EX, 2 PX; and where its argument is.
    var kind = 0;
    var amount_at = 0;
    var i = 3;
    while i < argc {
        let opt = reply.arg_of(view, table, i);
        if reply.is_word(opt, "NX") && !xx {
            nx = true;
        } else if reply.is_word(opt, "XX") && !nx {
            xx = true;
        } else if reply.is_word(opt, "GET") {
            get = true;
        } else if reply.is_word(opt, "KEEPTTL") && kind == 0 {
            keepttl = true;
        } else if reply.is_word(opt, "EX") && !keepttl && kind != 2 && i + 1 < argc {
            kind = 1;
            amount_at = i + 1;
            i = i + 1;
        } else if reply.is_word(opt, "PX") && !keepttl && kind != 1 && i + 1 < argc {
            kind = 2;
            amount_at = i + 1;
            i = i + 1;
        } else {
            return reply.syntax_error(sc, at);
        }
        i = i + 1;
    }
    var expiry = 0;
    if keepttl {
        expiry = 0 - 1;
    }
    if kind != 0 {
        let (status, amount) = reply.parse_int(reply.arg_of(view, table, amount_at));
        if status != 0 {
            return reply.not_an_integer(sc, at);
        }
        if amount <= 0 {
            return reply.put(sc, at, "-ERR invalid expire time in 'set' command\r\n");
        }
        let (bad, when) = expire_at(amount, kind == 1, store.now_of(st));
        if bad != 0 {
            return reply.put(sc, at, "-ERR invalid expire time in 'set' command\r\n");
        }
        expiry = when;
    }
    let key = reply.arg_of(view, table, 1);
    let h = store.hash_of(st, key);
    let e = store.find(st, key, h);
    // What the answer is if the write happens: the old value (`GET`), or OK. The old value is copied out before the write
    // can overwrite it.
    var o = at;
    if get {
        if e >= 0 {
            o = reply.put_bulk(sc, at, store.value(st, e));
        } else {
            o = reply.put_null(sc, at, proto);
        }
    }
    if nx && e >= 0 || xx && e < 0 {
        if get {
            return o;
        }
        return reply.put_null(sc, at, proto);
    }
    if store.set(st, key, h, reply.arg_of(view, table, 2), expiry) != 0 {
        return reply.refused(sc, at);
    }
    if get {
        return o;
    }
    return reply.put(sc, at, "+OK\r\n");
}

// The longest a string may be. It is what a command can carry (the input buffer, 16 KiB), because every reply buffer is sized for it:
// `reserve()` is `MGET` of the most keys with values this long, and a value any longer would overrun the buffer an answer is built in
// (a `GET` of 4 MB killed the server when `APPEND` and `SETRANGE` could build one). Redis's limit is 512 MiB (`proto-max-bulk-len`) and
// answers a longer result in the words used here; issue #11 lifts this one properly, with answers that are written in pieces.
fn max_string() -> [] int {
    return 16384;
}

fn too_long[&b](sc: &!b [byte], at: int) -> [] int {
    return reply.put(sc, at, "-ERR string exceeds maximum allowed size (proto-max-bulk-len)\r\n");
}

// `APPEND key value`: the length after.
fn command_append[&v, &t, &b, &s](view: &v [byte], table: &t [int], sc: &!b [byte], at: int, st: &!s store.Store) -> [] int {
    let key = reply.arg_of(view, table, 1);
    let value = reply.arg_of(view, table, 2);
    let h = store.hash_of(st, key);
    let e = store.find(st, key, h);
    if e >= 0 && store.kind_of(st, e) == store.kind_hash() {
        return reply.wrong_type(sc, at);
    }
    var old = 0;
    if e >= 0 {
        old = len(store.value(st, e));
    }
    if old + len(value) > max_string() {
        return too_long(sc, at);
    }
    if store.splice(st, key, h, old, value) != 0 {
        return reply.refused(sc, at);
    }
    return reply.put_integer(sc, at, old + len(value));
}

// `SETRANGE key offset value`: the length after.
fn command_setrange[&v, &t, &b, &s](view: &v [byte], table: &t [int], sc: &!b [byte], at: int, st: &!s store.Store) -> [] int {
    let (status, offset) = reply.parse_int(reply.arg_of(view, table, 2));
    if status != 0 {
        return reply.not_an_integer(sc, at);
    }
    if offset < 0 {
        return reply.put(sc, at, "-ERR offset is out of range\r\n");
    }
    let key = reply.arg_of(view, table, 1);
    let value = reply.arg_of(view, table, 3);
    let h = store.hash_of(st, key);
    let e = store.find(st, key, h);
    if e >= 0 && store.kind_of(st, e) == store.kind_hash() {
        return reply.wrong_type(sc, at);
    }
    var old = 0;
    if e >= 0 {
        old = len(store.value(st, e));
    }
    if len(value) == 0 {
        return reply.put_integer(sc, at, old);
    }
    if offset > max_string() - len(value) {
        return too_long(sc, at);
    }
    if store.splice(st, key, h, offset, value) != 0 {
        return reply.refused(sc, at);
    }
    if offset + len(value) > old {
        return reply.put_integer(sc, at, offset + len(value));
    }
    return reply.put_integer(sc, at, old);
}

// `GETRANGE key start end` (and its old name `SUBSTR`): the bytes from `start` to `end` inclusive, counting from the end when negative.
fn command_getrange[&v, &t, &b, &s](view: &v [byte], table: &t [int], sc: &!b [byte], at: int, st: &!s store.Store) -> [] int {
    let (s1, first) = reply.parse_int(reply.arg_of(view, table, 2));
    if s1 != 0 {
        return reply.not_an_integer(sc, at);
    }
    let (s2, last) = reply.parse_int(reply.arg_of(view, table, 3));
    if s2 != 0 {
        return reply.not_an_integer(sc, at);
    }
    let key = reply.arg_of(view, table, 1);
    let e = store.find(st, key, store.hash_of(st, key));
    if e < 0 {
        return reply.put(sc, at, "$0\r\n\r\n");
    }
    if store.kind_of(st, e) == store.kind_hash() {
        return reply.wrong_type(sc, at);
    }
    let value = store.value(st, e);
    let size = len(value);
    var start = first;
    var end = last;
    if start < 0 && end < 0 && start > end {
        return reply.put(sc, at, "$0\r\n\r\n");
    }
    if start < 0 {
        start = size + start;
    }
    if end < 0 {
        end = size + end;
    }
    if start < 0 {
        start = 0;
    }
    if end < 0 {
        end = 0;
    }
    if end >= size {
        end = size - 1;
    }
    if start > end || size == 0 {
        return reply.put(sc, at, "$0\r\n\r\n");
    }
    return reply.put_bulk(sc, at, value[start..end + 1]);
}

// `GETEX key [EX seconds | PX milliseconds | PERSIST]`: the value, and a new expiry for the key.
fn command_getex[&v, &t, &b, &s](view: &v [byte], table: &t [int], sc: &!b [byte], at: int, st: &!s store.Store, proto: int) -> [] int {
    let argc = table[0];
    var persist = false;
    // 0 none, 1 EX, 2 PX; and where its argument is.
    var kind = 0;
    var amount_at = 0;
    var i = 2;
    while i < argc {
        let opt = reply.arg_of(view, table, i);
        if reply.is_word(opt, "PERSIST") && kind == 0 {
            persist = true;
        } else if reply.is_word(opt, "EX") && !persist && kind != 2 && i + 1 < argc {
            kind = 1;
            amount_at = i + 1;
            i = i + 1;
        } else if reply.is_word(opt, "PX") && !persist && kind != 1 && i + 1 < argc {
            kind = 2;
            amount_at = i + 1;
            i = i + 1;
        } else {
            return reply.syntax_error(sc, at);
        }
        i = i + 1;
    }
    let key = reply.arg_of(view, table, 1);
    let h = store.hash_of(st, key);
    let e = store.find(st, key, h);
    if e < 0 {
        return reply.put_null(sc, at, proto);
    }
    if store.kind_of(st, e) == store.kind_hash() {
        return reply.wrong_type(sc, at);
    }
    var when = 0;
    if kind != 0 {
        let (status, amount) = reply.parse_int(reply.arg_of(view, table, amount_at));
        if status != 0 {
            return reply.not_an_integer(sc, at);
        }
        if amount <= 0 {
            return reply.put(sc, at, "-ERR invalid expire time in 'getex' command\r\n");
        }
        let (bad, at_when) = expire_at(amount, kind == 1, store.now_of(st));
        if bad != 0 {
            return reply.put(sc, at, "-ERR invalid expire time in 'getex' command\r\n");
        }
        when = at_when;
    }
    // The value goes into the answer before the key can be removed.
    let o = reply.put_bulk(sc, at, store.value(st, e));
    if kind != 0 {
        if when <= store.now_of(st) {
            store.delete(st, key, h);
        } else {
            store.set_expiry(st, e, when);
        }
    } else if persist {
        store.set_expiry(st, e, 0);
    }
    return o;
}

// `INCR`, `DECR`, `INCRBY`, `DECRBY`: add `delta` to the integer in the key, which starts at 0.
fn add_to[&k, &b, &s, &t](key: &k [byte], delta: int, sc: &!b [byte], at: int, st: &!s store.Store, tmp: &!t [byte]) -> [] int {
    let h = store.hash_of(st, key);
    let e = store.find(st, key, h);
    if e >= 0 && store.kind_of(st, e) == store.kind_hash() {
        return reply.wrong_type(sc, at);
    }
    var current = 0;
    if e >= 0 {
        let (status, n) = reply.parse_int(store.value(st, e));
        if status != 0 {
            return reply.not_an_integer(sc, at);
        }
        current = n;
    }
    if delta < 0 && current < reply.min_int() - delta || delta > 0 && current > reply.max_int() - delta {
        return reply.put(sc, at, "-ERR increment or decrement would overflow\r\n");
    }
    let next = current + delta;
    let size = reply.put_int(tmp, 0, next);
    if store.set(st, key, h, tmp[0..size], 0 - 1) != 0 {
        return reply.refused(sc, at);
    }
    return reply.put_integer(sc, at, next);
}

// `EXPIRE key seconds [NX | XX | GT | LT]` and `PEXPIRE key milliseconds [...]`.
fn command_expire[&v, &t, &b, &s](view: &v [byte], table: &t [int], sc: &!b [byte], at: int, st: &!s store.Store, seconds: bool) -> [] int {
    let argc = table[0];
    let (status, amount) = reply.parse_int(reply.arg_of(view, table, 2));
    if status != 0 {
        return reply.not_an_integer(sc, at);
    }
    var nx = false;
    var xx = false;
    var gt = false;
    var lt = false;
    var i = 3;
    while i < argc {
        let opt = reply.arg_of(view, table, i);
        if reply.is_word(opt, "NX") {
            nx = true;
        } else if reply.is_word(opt, "XX") {
            xx = true;
        } else if reply.is_word(opt, "GT") {
            gt = true;
        } else if reply.is_word(opt, "LT") {
            lt = true;
        } else {
            return reply.put(sc, reply.put(sc, reply.put(sc, at, "-ERR Unsupported option "), opt), "\r\n");
        }
        i = i + 1;
    }
    if nx && (xx || gt || lt) {
        return reply.put(sc, at, "-ERR NX and XX, GT or LT options at the same time are not compatible\r\n");
    }
    if gt && lt {
        return reply.put(sc, at, "-ERR GT and LT options at the same time are not compatible\r\n");
    }
    let now = store.now_of(st);
    let (bad, when) = expire_at(amount, seconds, now);
    if bad != 0 {
        if seconds {
            return reply.put(sc, at, "-ERR invalid expire time in 'expire' command\r\n");
        }
        return reply.put(sc, at, "-ERR invalid expire time in 'pexpire' command\r\n");
    }
    let key = reply.arg_of(view, table, 1);
    let e = store.find(st, key, store.hash_of(st, key));
    if e < 0 {
        return reply.put_integer(sc, at, 0);
    }
    let current = store.expiry_of(st, e);
    // A key with no expiry counts as infinitely far away for GT and LT.
    if nx && current != 0 || xx && current == 0 {
        return reply.put_integer(sc, at, 0);
    }
    if gt && (current == 0 || when <= current) {
        return reply.put_integer(sc, at, 0);
    }
    if lt && current != 0 && when >= current {
        return reply.put_integer(sc, at, 0);
    }
    if when <= now {
        // Already over: the key goes at once.
        store.delete(st, key, store.hash_of(st, key));
    } else {
        store.set_expiry(st, e, when);
    }
    return reply.put_integer(sc, at, 1);
}

// `TTL key` (seconds) and `PTTL key` (milliseconds): -2 if there is no such key, -1 if it has no expiry.
fn command_ttl[&v, &t, &b, &s](view: &v [byte], table: &t [int], sc: &!b [byte], at: int, st: &!s store.Store, seconds: bool) -> [] int {
    let key = reply.arg_of(view, table, 1);
    let e = store.find(st, key, store.hash_of(st, key));
    if e < 0 {
        return reply.put_integer(sc, at, 0 - 2);
    }
    let expiry = store.expiry_of(st, e);
    if expiry == 0 {
        return reply.put_integer(sc, at, 0 - 1);
    }
    var left = expiry - store.now_of(st);
    if left < 0 {
        left = 0;
    }
    if seconds {
        return reply.put_integer(sc, at, (left + 500) / 1000);
    }
    return reply.put_integer(sc, at, left);
}

// `SETEX key seconds value` and `PSETEX key milliseconds value`.
fn command_setex[&v, &t, &b, &s](view: &v [byte], table: &t [int], sc: &!b [byte], at: int, st: &!s store.Store, seconds: bool) -> [] int {
    let (status, amount) = reply.parse_int(reply.arg_of(view, table, 2));
    if status != 0 {
        return reply.not_an_integer(sc, at);
    }
    var bad = amount <= 0;
    var when = 0;
    if !bad {
        let (over, at_ms) = expire_at(amount, seconds, store.now_of(st));
        bad = over != 0;
        when = at_ms;
    }
    if bad {
        if seconds {
            return reply.put(sc, at, "-ERR invalid expire time in 'setex' command\r\n");
        }
        return reply.put(sc, at, "-ERR invalid expire time in 'psetex' command\r\n");
    }
    let key = reply.arg_of(view, table, 1);
    if store.set(st, key, store.hash_of(st, key), reply.arg_of(view, table, 3), when) != 0 {
        return reply.refused(sc, at);
    }
    return reply.put(sc, at, "+OK\r\n");
}

// Answer the command `table` describes in `view`, into `sc` from `at`. `tmp` is a few bytes of scratch (24 or more).
pub fn execute[&v, &t, &b, &s, &x, &c, &n, &w](view: &v [byte], table: &t [int], sc: &!b [byte], at: int, st: &!s store.Store, tmp: &!x [byte], link: &!c [int], names: &!n [byte], world: &w [int]) -> [] int {
    let argc = table[0];
    if argc == 0 {
        return at;
    }
    let name = reply.arg_of(view, table, 0);
    if reply.is_word(name, "GET") {
        if argc != 2 {
            return reply.wrong_arguments(sc, at, name);
        }
        let key = reply.arg_of(view, table, 1);
        let e = store.find(st, key, store.hash_of(st, key));
        if e < 0 {
            return reply.put_null(sc, at, link[3]);
        }
        if store.kind_of(st, e) == store.kind_hash() {
            return reply.wrong_type(sc, at);
        }
        return reply.put_bulk(sc, at, store.value(st, e));
    }
    if reply.is_word(name, "SET") {
        if argc < 3 {
            return reply.wrong_arguments(sc, at, name);
        }
        return command_set(view, table, sc, at, st, link[3]);
    }
    if reply.is_word(name, "PING") {
        if argc == 1 {
            return reply.put(sc, at, "+PONG\r\n");
        }
        if argc == 2 {
            return reply.put_bulk(sc, at, reply.arg_of(view, table, 1));
        }
        return reply.wrong_arguments(sc, at, name);
    }
    if reply.is_word(name, "ECHO") {
        if argc == 2 {
            return reply.put_bulk(sc, at, reply.arg_of(view, table, 1));
        }
        return reply.wrong_arguments(sc, at, name);
    }
    if reply.is_word(name, "DEL") || reply.is_word(name, "UNLINK") {
        if argc < 2 {
            return reply.wrong_arguments(sc, at, name);
        }
        var removed = 0;
        var k = 1;
        while k < argc {
            let key = reply.arg_of(view, table, k);
            removed = removed + store.delete(st, key, store.hash_of(st, key));
            k = k + 1;
        }
        return reply.put_integer(sc, at, removed);
    }
    if reply.is_word(name, "EXISTS") || reply.is_word(name, "TOUCH") {
        if argc < 2 {
            return reply.wrong_arguments(sc, at, name);
        }
        var found = 0;
        var k = 1;
        while k < argc {
            let key = reply.arg_of(view, table, k);
            if store.find(st, key, store.hash_of(st, key)) >= 0 {
                found = found + 1;
            }
            k = k + 1;
        }
        return reply.put_integer(sc, at, found);
    }
    if reply.is_word(name, "INCR") || reply.is_word(name, "DECR") {
        if argc != 2 {
            return reply.wrong_arguments(sc, at, name);
        }
        var delta = 1;
        if reply.is_word(name, "DECR") {
            delta = 0 - 1;
        }
        return add_to(reply.arg_of(view, table, 1), delta, sc, at, st, tmp);
    }
    if reply.is_word(name, "INCRBY") || reply.is_word(name, "DECRBY") {
        if argc != 3 {
            return reply.wrong_arguments(sc, at, name);
        }
        let (status, n) = reply.parse_int(reply.arg_of(view, table, 2));
        if status != 0 {
            return reply.not_an_integer(sc, at);
        }
        if reply.is_word(name, "DECRBY") {
            if n == reply.min_int() {
                return reply.put(sc, at, "-ERR decrement would overflow\r\n");
            }
            return add_to(reply.arg_of(view, table, 1), 0 - n, sc, at, st, tmp);
        }
        return add_to(reply.arg_of(view, table, 1), n, sc, at, st, tmp);
    }
    if reply.is_word(name, "EXPIRE") || reply.is_word(name, "PEXPIRE") {
        if argc < 3 {
            return reply.wrong_arguments(sc, at, name);
        }
        return command_expire(view, table, sc, at, st, reply.is_word(name, "EXPIRE"));
    }
    if reply.is_word(name, "TTL") || reply.is_word(name, "PTTL") {
        if argc != 2 {
            return reply.wrong_arguments(sc, at, name);
        }
        return command_ttl(view, table, sc, at, st, reply.is_word(name, "TTL"));
    }
    if reply.is_word(name, "PERSIST") {
        if argc != 2 {
            return reply.wrong_arguments(sc, at, name);
        }
        let key = reply.arg_of(view, table, 1);
        let e = store.find(st, key, store.hash_of(st, key));
        if e < 0 || store.expiry_of(st, e) == 0 {
            return reply.put_integer(sc, at, 0);
        }
        store.set_expiry(st, e, 0);
        return reply.put_integer(sc, at, 1);
    }
    if reply.is_word(name, "SETNX") {
        if argc != 3 {
            return reply.wrong_arguments(sc, at, name);
        }
        let key = reply.arg_of(view, table, 1);
        let h = store.hash_of(st, key);
        if store.find(st, key, h) >= 0 {
            return reply.put_integer(sc, at, 0);
        }
        if store.set(st, key, h, reply.arg_of(view, table, 2), 0) != 0 {
            return reply.refused(sc, at);
        }
        return reply.put_integer(sc, at, 1);
    }
    if reply.is_word(name, "SETEX") || reply.is_word(name, "PSETEX") {
        if argc != 4 {
            return reply.wrong_arguments(sc, at, name);
        }
        return command_setex(view, table, sc, at, st, reply.is_word(name, "SETEX"));
    }
    if reply.is_word(name, "GETSET") {
        if argc != 3 {
            return reply.wrong_arguments(sc, at, name);
        }
        let key = reply.arg_of(view, table, 1);
        let h = store.hash_of(st, key);
        let e = store.find(st, key, h);
        if e >= 0 && store.kind_of(st, e) == store.kind_hash() {
            return reply.wrong_type(sc, at);
        }
        var o = at;
        if e >= 0 {
            o = reply.put_bulk(sc, at, store.value(st, e));
        } else {
            o = reply.put_null(sc, at, link[3]);
        }
        if store.set(st, key, h, reply.arg_of(view, table, 2), 0) != 0 {
            return reply.refused(sc, at);
        }
        return o;
    }
    if reply.is_word(name, "GETDEL") {
        if argc != 2 {
            return reply.wrong_arguments(sc, at, name);
        }
        let key = reply.arg_of(view, table, 1);
        let h = store.hash_of(st, key);
        let e = store.find(st, key, h);
        if e < 0 {
            return reply.put_null(sc, at, link[3]);
        }
        if store.kind_of(st, e) == store.kind_hash() {
            return reply.wrong_type(sc, at);
        }
        let o = reply.put_bulk(sc, at, store.value(st, e));
        store.delete(st, key, h);
        return o;
    }
    if reply.is_word(name, "MGET") {
        if argc < 2 {
            return reply.wrong_arguments(sc, at, name);
        }
        var o = reply.put(sc, reply.put_nat(sc, reply.put(sc, at, "*"), argc - 1), "\r\n");
        var k = 1;
        while k < argc {
            let key = reply.arg_of(view, table, k);
            let e = store.find(st, key, store.hash_of(st, key));
            if e >= 0 && store.kind_of(st, e) == store.kind_hash() {
                return reply.wrong_type(sc, at);
            }
            if e < 0 {
                o = reply.put_null(sc, o, link[3]);
            } else {
                o = reply.put_bulk(sc, o, store.value(st, e));
            }
            k = k + 1;
        }
        return o;
    }
    if reply.is_word(name, "MSET") {
        if argc < 3 || argc % 2 == 0 {
            return reply.wrong_arguments(sc, at, name);
        }
        var k = 1;
        while k < argc {
            let key = reply.arg_of(view, table, k);
            if store.set(st, key, store.hash_of(st, key), reply.arg_of(view, table, k + 1), 0) != 0 {
                return reply.refused(sc, at);
            }
            k = k + 2;
        }
        return reply.put(sc, at, "+OK\r\n");
    }
    if reply.is_word(name, "APPEND") {
        if argc != 3 {
            return reply.wrong_arguments(sc, at, name);
        }
        return command_append(view, table, sc, at, st);
    }
    if reply.is_word(name, "SETRANGE") {
        if argc != 4 {
            return reply.wrong_arguments(sc, at, name);
        }
        return command_setrange(view, table, sc, at, st);
    }
    if reply.is_word(name, "GETRANGE") || reply.is_word(name, "SUBSTR") {
        if argc != 4 {
            return reply.wrong_arguments(sc, at, name);
        }
        return command_getrange(view, table, sc, at, st);
    }
    if reply.is_word(name, "GETEX") {
        if argc < 2 {
            return reply.wrong_arguments(sc, at, name);
        }
        return command_getex(view, table, sc, at, st, link[3]);
    }
    if reply.is_word(name, "MSETNX") {
        if argc < 3 || argc % 2 == 0 {
            return reply.wrong_arguments(sc, at, name);
        }
        var j = 1;
        while j < argc {
            let key = reply.arg_of(view, table, j);
            if store.find(st, key, store.hash_of(st, key)) >= 0 {
                return reply.put_integer(sc, at, 0);
            }
            j = j + 2;
        }
        j = 1;
        while j < argc {
            let key = reply.arg_of(view, table, j);
            if store.set(st, key, store.hash_of(st, key), reply.arg_of(view, table, j + 1), 0) != 0 {
                return reply.refused(sc, at);
            }
            j = j + 2;
        }
        return reply.put_integer(sc, at, 1);
    }
    if reply.is_word(name, "KEYS") {
        if argc != 2 {
            return reply.wrong_arguments(sc, at, name);
        }
        return command_keys(view, table, sc, at, st);
    }
    if reply.is_word(name, "SCAN") {
        if argc < 2 {
            return reply.wrong_arguments(sc, at, name);
        }
        return command_scan(view, table, sc, at, st);
    }
    if reply.is_word(name, "RANDOMKEY") {
        if argc != 1 {
            return reply.wrong_arguments(sc, at, name);
        }
        let e = store.random_visible(st);
        if e < 0 {
            return reply.put_null(sc, at, link[3]);
        }
        return reply.put_bulk(sc, at, store.key_at(st, e));
    }
    if reply.is_word(name, "RENAME") || reply.is_word(name, "RENAMENX") {
        if argc != 3 {
            return reply.wrong_arguments(sc, at, name);
        }
        return command_rename(view, table, sc, at, st, reply.is_word(name, "RENAMENX"));
    }
    if reply.is_word(name, "STRLEN") {
        if argc != 2 {
            return reply.wrong_arguments(sc, at, name);
        }
        let key = reply.arg_of(view, table, 1);
        let e = store.find(st, key, store.hash_of(st, key));
        if e < 0 {
            return reply.put_integer(sc, at, 0);
        }
        if store.kind_of(st, e) == store.kind_hash() {
            return reply.wrong_type(sc, at);
        }
        return reply.put_integer(sc, at, len(store.value(st, e)));
    }
    if reply.is_word(name, "TYPE") {
        if argc != 2 {
            return reply.wrong_arguments(sc, at, name);
        }
        let key = reply.arg_of(view, table, 1);
        let e = store.find(st, key, store.hash_of(st, key));
        if e < 0 {
            return reply.put(sc, at, "+none\r\n");
        }
        if store.kind_of(st, e) == store.kind_hash() {
            return reply.put(sc, at, "+hash\r\n");
        }
        return reply.put(sc, at, "+string\r\n");
    }
    if reply.is_word(name, "DBSIZE") {
        if argc != 1 {
            return reply.wrong_arguments(sc, at, name);
        }
        return reply.put_integer(sc, at, store.live(st));
    }
    if reply.is_word(name, "FLUSHALL") || reply.is_word(name, "FLUSHDB") {
        if argc > 2 {
            return reply.syntax_error(sc, at);
        }
        if argc == 2 && !reply.is_word(reply.arg_of(view, table, 1), "ASYNC") && !reply.is_word(reply.arg_of(view, table, 1), "SYNC") {
            return reply.syntax_error(sc, at);
        }
        store.clear(st);
        return reply.put(sc, at, "+OK\r\n");
    }
    if reply.is_word(name, "SELECT") {
        if argc != 2 {
            return reply.wrong_arguments(sc, at, name);
        }
        let (status, n) = reply.parse_int(reply.arg_of(view, table, 1));
        if status != 0 {
            return reply.not_an_integer(sc, at);
        }
        if n != 0 {
            return reply.put(sc, at, "-ERR DB index is out of range\r\n");
        }
        return reply.put(sc, at, "+OK\r\n");
    }
    // The commands about the connection and the server (`src/session.cho`).
    if reply.is_word(name, "HELLO") {
        return session.hello(view, table, sc, at, link, names);
    }
    if reply.is_word(name, "AUTH") {
        return session.auth(view, table, sc, at);
    }
    if reply.is_word(name, "CLIENT") {
        return session.client(view, table, sc, at, link, names);
    }
    if reply.is_word(name, "INFO") {
        return session.info(view, table, sc, at, st, world);
    }
    if reply.is_word(name, "CONFIG") {
        return session.config(view, table, sc, at, st, world, link[3]);
    }
    if reply.is_word(name, "COMMAND") {
        return session.command(view, table, sc, at);
    }
    if reply.is_word(name, "QUIT") {
        return session.quit(sc, at, link);
    }
    if reply.is_word(name, "RESET") {
        if argc != 1 {
            return reply.wrong_arguments(sc, at, name);
        }
        return session.reset(sc, at, link);
    }
    if reply.is_word(name, "HSET") || reply.is_word(name, "HSETNX") {
        if table[0] < 4 || (table[0] - 2) % 2 == 1 {
            return reply.wrong_arguments(sc, at, name);
        }
        return command_hset(view, table, sc, at, st, tmp, reply.is_word(name, "HSETNX"));
    }
    if reply.is_word(name, "HMSET") {
        if table[0] < 4 || (table[0] - 2) % 2 == 1 {
            return reply.wrong_arguments(sc, at, name);
        }
        var set = command_hset(view, table, sc, at, st, tmp, false);
        if set != at {
            // A WRONGTYPE or OOM reply: pass it through.
            return set;
        }
        return reply.put(sc, at, "+OK\r\n");
    }
    if reply.is_word(name, "HGET") {
        if table[0] != 3 {
            return reply.wrong_arguments(sc, at, name);
        }
        let (e, o) = hash_entry(view, table, sc, at, st, 1);
        if e == 0 - 1 {
            return reply.put_null(sc, o, link[3]);
        }
        if e < 0 {
            return o;
        }
        let packed = store.value(st, e);
        let (found, spot) = hash_find(packed, reply.arg_of(view, table, 2));
        if !found {
            return reply.put_null(sc, at, link[3]);
        }
        return reply.put_bulk(sc, at, pair_value(packed, spot));
    }
    if reply.is_word(name, "HDEL") {
        if table[0] < 3 {
            return reply.wrong_arguments(sc, at, name);
        }
        let (e, o) = hash_entry(view, table, sc, at, st, 1);
        if e == 0 - 1 {
            return reply.put_integer(sc, at, 0);
        }
        if e < 0 {
            return o;
        }
        var removed = 0;
        var k = 2;
        while k < table[0] {
            let packed = store.value(st, e);
            let (found, spot) = hash_find(packed, reply.arg_of(view, table, k));
            if found {
                let vfrom = spot + pair_header() + get_len(packed, spot);
                let vend = vfrom + get_len(packed, spot + 4);
                if store.value_splice(st, e, spot, vend, "") != 0 {
                    return reply.refused(sc, at);
                }
                removed = removed + 1;
            }
            k = k + 1;
        }
        if removed > 0 && hash_len(store.value(st, e)) == 0 {
            let key = reply.arg_of(view, table, 1);
            store.delete(st, key, store.hash_of(st, key));
        }
        return reply.put_integer(sc, at, removed);
    }
    if reply.is_word(name, "HLEN") {
        if table[0] != 2 {
            return reply.wrong_arguments(sc, at, name);
        }
        let (e, o) = hash_entry(view, table, sc, at, st, 1);
        if e == 0 - 1 {
            return reply.put_integer(sc, at, 0);
        }
        if e < 0 {
            return o;
        }
        return reply.put_integer(sc, at, hash_len(store.value(st, e)));
    }
    if reply.is_word(name, "HSTRLEN") || reply.is_word(name, "HEXISTS") {
        if table[0] != 3 {
            return reply.wrong_arguments(sc, at, name);
        }
        let (e, o) = hash_entry(view, table, sc, at, st, 1);
        if e == 0 - 1 {
            return reply.put_integer(sc, at, 0);
        }
        if e < 0 {
            return o;
        }
        let packed = store.value(st, e);
        let (found, spot) = hash_find(packed, reply.arg_of(view, table, 2));
        if reply.is_word(name, "HEXISTS") {
            if found {
                return reply.put_integer(sc, at, 1);
            }
            return reply.put_integer(sc, at, 0);
        }
        if !found {
            return reply.put_integer(sc, at, 0);
        }
        return reply.put_integer(sc, at, get_len(packed, spot + 4));
    }
    if reply.is_word(name, "HMGET") {
        if table[0] < 3 {
            return reply.wrong_arguments(sc, at, name);
        }
        var out = reply.put(sc, reply.put_nat(sc, reply.put(sc, at, "*"), table[0] - 2), "\r\n");
        let (e, o) = hash_entry(view, table, sc, out, st, 1);
        if e < 0 {
            if e == 0 - 2 {
                return o;
            }
            var none = out;
            var j = 2;
            while j < table[0] {
                none = reply.put_null(sc, none, link[3]);
                j = j + 1;
            }
            return none;
        }
        var j = 2;
        while j < table[0] {
            let packed = store.value(st, e);
            let (found, spot) = hash_find(packed, reply.arg_of(view, table, j));
            if found {
                out = reply.put_bulk(sc, out, pair_value(packed, spot));
            } else {
                out = reply.put_null(sc, out, link[3]);
            }
            j = j + 1;
        }
        return out;
    }
    if reply.is_word(name, "HGETALL") || reply.is_word(name, "HKEYS") || reply.is_word(name, "HVALS") {
        if table[0] != 2 {
            return reply.wrong_arguments(sc, at, name);
        }
        let (e, o) = hash_entry(view, table, sc, at, st, 1);
        if e == 0 - 1 {
            return reply.put(sc, at, "*0\r\n");
        }
        if e < 0 {
            return o;
        }
        let packed = store.value(st, e);
        let n = hash_len(packed);
        var out = reply.put_nat(sc, reply.put(sc, at, "*"), n);
        if reply.is_word(name, "HGETALL") {
            out = reply.put_nat(sc, reply.put(sc, at, "*"), n * 2);
        }
        out = reply.put(sc, out, "\r\n");
        var spot = 0;
        while spot + pair_header() <= len(packed) {
            let flen = get_len(packed, spot);
            let vlen = get_len(packed, spot + 4);
            let field_at = spot + pair_header();
            let value_at = field_at + flen;
            if reply.is_word(name, "HGETALL") {
                out = reply.put_bulk(sc, out, packed[field_at..value_at]);
                out = reply.put_bulk(sc, out, packed[value_at..value_at + vlen]);
            }
            if reply.is_word(name, "HKEYS") {
                out = reply.put_bulk(sc, out, packed[field_at..value_at]);
            }
            if reply.is_word(name, "HVALS") {
                out = reply.put_bulk(sc, out, packed[value_at..value_at + vlen]);
            }
            spot = value_at + vlen;
        }
        return out;
    }
    if reply.is_word(name, "HINCRBY") {
        if table[0] != 4 {
            return reply.wrong_arguments(sc, at, name);
        }
        let (status, n) = reply.parse_int(reply.arg_of(view, table, 3));
        if status != 0 {
            return reply.not_an_integer(sc, at);
        }
        let key = reply.arg_of(view, table, 1);
        let h = store.hash_of(st, key);
        var e = store.find(st, key, h);
        if e >= 0 && store.kind_of(st, e) == store.kind_string() {
            return reply.wrong_type(sc, at);
        }
        if e < 0 {
            if store.set(st, key, h, "", 0 - 1) != 0 {
                return reply.refused(sc, at);
            }
            e = store.find(st, key, h);
            store.set_kind(st, e, store.kind_hash());
        }
        let field = reply.arg_of(view, table, 2);
        let packed = store.value(st, e);
        let (found, spot) = hash_find(packed, field);
        var current = 0;
        if found {
            let (parse, got) = reply.parse_int(pair_value(packed, spot));
            if parse != 0 {
                return reply.put(sc, at, "-ERR hash value is not an integer\r\n");
            }
            current = got;
        }
        if n > 0 && current > reply.max_int() - n {
            return reply.put(sc, at, "-ERR increment or decrement would overflow\r\n");
        }
        if n < 0 && current < reply.min_int() - n {
            return reply.put(sc, at, "-ERR increment or decrement would overflow\r\n");
        }
        var next = current + n;
        let size = reply.put_int(tmp, 0, next);
        if hash_set_one(st, e, field, tmp[0..size]) != 0 {
            return reply.refused(sc, at);
        }
        return reply.put_integer(sc, at, next);
    }
    if reply.is_word(name, "HRANDFIELD") {
        if table[0] != 2 && table[0] != 3 && table[0] != 4 {
            return reply.wrong_arguments(sc, at, name);
        }
        var count = 1;
        var with_values = false;
        if table[0] >= 3 {
            let (status, n) = reply.parse_int(reply.arg_of(view, table, 2));
            if status != 0 {
                return reply.not_an_integer(sc, at);
            }
            count = n;
            if table[0] == 4 {
                if !reply.is_word(reply.arg_of(view, table, 3), "WITHVALUES") {
                    return reply.syntax_error(sc, at);
                }
                with_values = true;
            }
        }
        let (e, o) = hash_entry(view, table, sc, at, st, 1);
        if e == 0 - 1 {
            if table[0] == 2 {
                return reply.put_null(sc, o, link[3]);
            }
            return reply.put(sc, o, "*0\r\n");
        }
        if e < 0 {
            return o;
        }
        let packed = store.value(st, e);
        let n = hash_len(packed);
        // Without a count the answer is one bulk field, not an array (Redis 7.0's own shape).
        if table[0] == 2 {
            let which = store.random_below(st, n);
            var spot = 0;
            var seen = 0;
            while seen < which {
                spot = spot + pair_header() + get_len(packed, spot) + get_len(packed, spot + 4);
                seen = seen + 1;
            }
            let flen = get_len(packed, spot);
            return reply.put_bulk(sc, o, packed[spot + pair_header()..spot + pair_header() + flen]);
        }
        // The offsets of every pair: picked without replacement when count >= 0, with repeats when not.
        var take = count;
        if count >= 0 && take > n {
            take = n;
        }
        if count < 0 {
            take = 0 - take;
        }
        var shown = take;
        if with_values {
            shown = take * 2;
        }
        var out = reply.put(sc, reply.put_nat(sc, reply.put(sc, o, "*"), shown), "\r\n");
        region a {
            if count < 0 {
                // Repetition: a fresh random pair each time.
                var i = 0;
                while i < take {
                    let which = store.random_below(st, n);
                    var spot = 0;
                    var seen = 0;
                    while seen < which {
                        spot = spot + pair_header() + get_len(packed, spot) + get_len(packed, spot + 4);
                        seen = seen + 1;
                    }
                    let flen = get_len(packed, spot);
                    let vlen = get_len(packed, spot + 4);
                    out = reply.put_bulk(sc, out, packed[spot + pair_header()..spot + pair_header() + flen]);
                    if with_values {
                        out = reply.put_bulk(sc, out, packed[spot + pair_header() + flen..spot + pair_header() + flen + vlen]);
                    }
                    i = i + 1;
                }
            } else {
                // Without replacement: a used-mask over the pairs (the reply is at most the arena's pairs).
                let used = alloc_slice[a](n, 0);
                var i = 0;
                while i < take {
                    var which = store.random_below(st, n);
                    while used[which] != 0 {
                        which = which + 1;
                        if which >= n {
                            which = 0;
                        }
                    }
                    used[which] = 1;
                    var spot = 0;
                    var seen = 0;
                    while seen < which {
                        spot = spot + pair_header() + get_len(packed, spot) + get_len(packed, spot + 4);
                        seen = seen + 1;
                    }
                    let flen = get_len(packed, spot);
                    let vlen = get_len(packed, spot + 4);
                    out = reply.put_bulk(sc, out, packed[spot + pair_header()..spot + pair_header() + flen]);
                    if with_values {
                        out = reply.put_bulk(sc, out, packed[spot + pair_header() + flen..spot + pair_header() + flen + vlen]);
                    }
                    i = i + 1;
                }
            }
        }
        return out;
    }
    if reply.is_word(name, "HSCAN") {
        if table[0] < 3 {
            return reply.wrong_arguments(sc, at, name);
        }
        let (status, cursor) = parse_cursor(reply.arg_of(view, table, 2));
        if status != 0 {
            return reply.put(sc, at, "-ERR invalid cursor\r\n");
        }
        var count = 10;
        var pattern_at = 0;
        var no_values = false;
        var i = 3;
        while i < table[0] {
            let opt = reply.arg_of(view, table, i);
            let more = table[0] - i;
            if reply.is_word(opt, "COUNT") && more >= 2 {
                let (bad, n) = reply.parse_int(reply.arg_of(view, table, i + 1));
                if bad != 0 {
                    return reply.not_an_integer(sc, at);
                }
                if n < 1 {
                    return reply.syntax_error(sc, at);
                }
                count = n;
                i = i + 2;
            } else if reply.is_word(opt, "MATCH") && more >= 2 {
                pattern_at = i + 1;
                i = i + 2;
            } else if reply.is_word(opt, "NOVALUES") && reply.is_word(name, "HSCAN") {
                no_values = true;
                i = i + 1;
            } else {
                return reply.syntax_error(sc, at);
            }
        }
        var pattern = reply.arg_of(view, table, 2)[0..0];
        var filtered = false;
        if pattern_at != 0 {
            pattern = reply.arg_of(view, table, pattern_at);
            filtered = !(len(pattern) == 1 && int_of(pattern[0]) == '*');
        }
        let (e, o) = hash_entry(view, table, sc, at, st, 1);
        if e == 0 - 1 {
            return reply.put(sc, o, "*2\r\n$1\r\n0\r\n*0\r\n");
        }
        if e < 0 {
            return o;
        }
        let packed = store.value(st, e);
        // The cursor is a pair number: the call looks at `COUNT` pairs from there, answers the ones
        // that match, and says where to go on from (0: done).
        var spot = 0;
        var pairs = 0;
        while pairs < cursor && spot + pair_header() <= len(packed) {
            spot = spot + pair_header() + get_len(packed, spot) + get_len(packed, spot + 4);
            pairs = pairs + 1;
        }
        var looked = 0;
        var found = 0;
        var bytes = 0;
        var going = true;
        while going && spot + pair_header() <= len(packed) && looked < count {
            let flen = get_len(packed, spot);
            let vlen = get_len(packed, spot + 4);
            let field = packed[spot + pair_header()..spot + pair_header() + flen];
            if !filtered || glob.matches(pattern, field) {
                var pair_bytes = bulk_size(flen);
                if !no_values {
                    pair_bytes = pair_bytes + bulk_size(vlen);
                }
                if bytes + pair_bytes > reserve() - 256 {
                    going = false;
                } else {
                    found = found + 1;
                    bytes = bytes + pair_bytes;
                }
            }
            if going {
                spot = spot + pair_header() + flen + vlen;
                looked = looked + 1;
            }
        }
        var next = pairs + looked;
        if spot + pair_header() > len(packed) {
            next = 0;
        }
        var out = reply.put(sc, o, "*2\r\n$");
        out = reply.put_nat(sc, out, digits_of(next));
        out = reply.put(sc, out, "\r\n");
        out = reply.put_nat(sc, out, next);
        out = reply.put(sc, out, "\r\n*");
        var shown = found * 2;
        if no_values {
            shown = found;
        }
        out = reply.put_nat(sc, out, shown);
        out = reply.put(sc, out, "\r\n");
        // The second pass: the fields (and values) themselves, re-walked from the cursor.
        spot = 0;
        var pair_no = 0;
        var emitted = 0;
        while pair_no < pairs {
            spot = spot + pair_header() + get_len(packed, spot) + get_len(packed, spot + 4);
            pair_no = pair_no + 1;
        }
        while emitted < found && spot + pair_header() <= len(packed) {
            let flen = get_len(packed, spot);
            let vlen = get_len(packed, spot + 4);
            let field = packed[spot + pair_header()..spot + pair_header() + flen];
            if !filtered || glob.matches(pattern, field) {
                out = reply.put_bulk(sc, out, field);
                if !no_values {
                    out = reply.put_bulk(sc, out, packed[spot + pair_header() + flen..spot + pair_header() + flen + vlen]);
                }
                emitted = emitted + 1;
            }
            spot = spot + pair_header() + flen + vlen;
        }
        return out;
    }
    // Redis names the command (at most 128 bytes of it) and then the arguments, as `'arg' ` each, until the
    // text so far is 128 bytes: the quotes and spaces count, and the last argument is cut to what is left.
    var shown = len(name);
    if shown > 128 {
        shown = 128;
    }
    var o = reply.put(sc, at, "-ERR unknown command '");
    o = reply.put(sc, o, name[0..shown]);
    o = reply.put(sc, o, "', with args beginning with: ");
    var spent = 0;
    var k = 1;
    while k < argc && spent < 128 {
        var take = table[2 + 2 * k];
        if take > 128 - spent {
            take = 128 - spent;
        }
        o = reply.put(sc, o, "'");
        o = reply.put(sc, o, reply.arg_of(view, table, k)[0..take]);
        o = reply.put(sc, o, "' ");
        spent = spent + take + 3;
        k = k + 1;
    }
    return reply.put(sc, o, "\r\n");
}

// ---------------------------------------------------------------------
// The keyspace: KEYS, SCAN, RANDOMKEY, RENAME, RENAMENX (docs/design.md section 16)
// ---------------------------------------------------------------------

// Digits of `n >= 0`.
fn digits_of(n: int) -> [] int {
    var d = 1;
    var rest = n / 10;
    while rest > 0 {
        d = d + 1;
        rest = rest / 10;
    }
    return d;
}

// The bytes `$len\r\n`, the key and `\r\n` take.
fn bulk_size(n: int) -> [] int {
    return 5 + digits_of(n) + n;
}

// `KEYS pattern`: every key that matches, in the order of the entry numbers. Redis answers with all of them whatever their number; this answers
// in one piece, so a reply that would not fit the buffer one command may fill is refused, and `SCAN` is how to read that many.
fn command_keys[&v, &t, &b, &s](view: &v [byte], table: &t [int], sc: &!b [byte], at: int, st: &!s store.Store) -> [] int {
    let pattern = reply.arg_of(view, table, 1);
    let all = len(pattern) == 1 && int_of(pattern[0]) == '*';
    let n = store.entries(st);
    var count = 0;
    var bytes = 0;
    var e = 0;
    while e < n {
        if store.visible(st, e) {
            let key = store.key_at(st, e);
            if all || glob.matches(pattern, key) {
                count = count + 1;
                bytes = bytes + bulk_size(len(key));
            }
        }
        e = e + 1;
    }
    if bytes + 3 + digits_of(count) > reserve() - 64 {
        return reply.put(sc, at, "-ERR the keys do not fit one reply: use SCAN\r\n");
    }
    var o = reply.put(sc, at, "*");
    o = reply.put_nat(sc, o, count);
    o = reply.put(sc, o, "\r\n");
    e = 0;
    while e < n {
        if store.visible(st, e) {
            let key = store.key_at(st, e);
            if all || glob.matches(pattern, key) {
                o = reply.put_bulk(sc, o, key);
            }
        }
        e = e + 1;
    }
    return o;
}

// A `SCAN` cursor as Redis reads one (`strtoul`): digits, with a leading `+`, or a `-` that makes it huge; empty is 0. `(1, 0)` if it is
// not a cursor. A number past what an int holds is a cursor past the end of the keys, which ends the scan.
fn parse_cursor[&w](text: &w [byte]) -> [] (int, int) {
    var i = 0;
    var huge = false;
    if len(text) > 0 && (reply.is_word_exact(text[0..1], "+") || reply.is_word_exact(text[0..1], "-")) {
        huge = reply.is_word_exact(text[0..1], "-");
        i = 1;
    }
    var value = 0;
    var first = 0 - 1;
    var past = false;
    while i < len(text) {
        let c = int_of(text[i]);
        if c < '0' || c > '9' {
            return (1, 0);
        }
        if c != '0' && first < 0 {
            first = i;
        }
        if first >= 0 && i - first >= 20 {
            return (1, 0);
        }
        if value > (reply.max_int() - (c - '0')) / 10 {
            past = true;
        } else {
            value = value * 10 + (c - '0');
        }
        i = i + 1;
    }
    // Twenty digits are an unsigned 64-bit number only up to 18446744073709551615.
    if first >= 0 && len(text) - first == 20 {
        let top = "18446744073709551615";
        var k = 0;
        while k < 20 {
            let a = int_of(text[first + k]);
            let b = int_of(top[k]);
            if a > b {
                return (1, 0);
            }
            if a < b {
                k = 20;
            } else {
                k = k + 1;
            }
        }
    }
    if past || huge && value != 0 {
        return (0, reply.max_int());
    }
    return (0, value);
}

// `SCAN cursor [MATCH pattern] [COUNT n] [TYPE type]`. The cursor is an entry number: the call looks at `COUNT` entries from there (fewer if
// the answer would not fit), answers the matching keys and the entry to go on from, 0 at the end.
fn command_scan[&v, &t, &b, &s](view: &v [byte], table: &t [int], sc: &!b [byte], at: int, st: &!s store.Store) -> [] int {
    let argc = table[0];
    let (status, cursor) = parse_cursor(reply.arg_of(view, table, 1));
    if status != 0 {
        return reply.put(sc, at, "-ERR invalid cursor\r\n");
    }
    var count = 10;
    var pattern_at = 0;
    var type_at = 0;
    var i = 2;
    while i < argc {
        let opt = reply.arg_of(view, table, i);
        let more = argc - i;
        if reply.is_word(opt, "COUNT") && more >= 2 {
            let (bad, n) = reply.parse_int(reply.arg_of(view, table, i + 1));
            if bad != 0 {
                return reply.not_an_integer(sc, at);
            }
            if n < 1 {
                return reply.syntax_error(sc, at);
            }
            count = n;
            i = i + 2;
        } else if reply.is_word(opt, "MATCH") && more >= 2 {
            pattern_at = i + 1;
            i = i + 2;
        } else if reply.is_word(opt, "TYPE") && more >= 2 {
            type_at = i + 1;
            i = i + 2;
        } else {
            return reply.syntax_error(sc, at);
        }
    }
    // Every key here is a string: a `TYPE` other than that matches none.
    var want_string = false;
    var want_hash = false;
    var type_ok = true;
    if type_at != 0 {
        if reply.is_word(reply.arg_of(view, table, type_at), "STRING") {
            want_string = true;
        } else if reply.is_word(reply.arg_of(view, table, type_at), "HASH") {
            want_hash = true;
        } else {
            type_ok = false;
        }
    }
    var pattern = reply.arg_of(view, table, 1)[0..0];
    var filtered = false;
    if pattern_at != 0 {
        pattern = reply.arg_of(view, table, pattern_at);
        filtered = !(len(pattern) == 1 && int_of(pattern[0]) == '*');
    }
    let n = store.entries(st);
    // The first pass: how far to look, and how many keys and bytes that gives.
    var e = cursor;
    if e > n {
        e = n;
    }
    var looked = 0;
    var found = 0;
    var bytes = 0;
    var going = true;
    while going && e < n && looked < count {
        if type_ok && store.visible(st, e) && (!want_string && !want_hash || want_string && store.kind_of(st, e) == store.kind_string() || want_hash && store.kind_of(st, e) == store.kind_hash()) {
            let key = store.key_at(st, e);
            if !filtered || glob.matches(pattern, key) {
                if bytes + bulk_size(len(key)) > reserve() - 256 {
                    going = false;
                } else {
                    found = found + 1;
                    bytes = bytes + bulk_size(len(key));
                }
            }
        }
        if going {
            e = e + 1;
            looked = looked + 1;
        }
    }
    var next = e;
    if e >= n {
        next = 0;
    }
    var o = reply.put(sc, at, "*2\r\n$");
    o = reply.put_nat(sc, o, digits_of(next));
    o = reply.put(sc, o, "\r\n");
    o = reply.put_nat(sc, o, next);
    o = reply.put(sc, o, "\r\n*");
    o = reply.put_nat(sc, o, found);
    o = reply.put(sc, o, "\r\n");
    var k = cursor;
    if k > n {
        k = n;
    }
    while k < e {
        if type_ok && store.visible(st, k) && (!want_string && !want_hash || want_string && store.kind_of(st, k) == store.kind_string() || want_hash && store.kind_of(st, k) == store.kind_hash()) {
            let key = store.key_at(st, k);
            if !filtered || glob.matches(pattern, key) {
                o = reply.put_bulk(sc, o, key);
            }
        }
        k = k + 1;
    }
    return o;
}

// Whether two byte strings are the same.
fn same_bytes[&x, &y](a: &x [byte], b: &y [byte]) -> [] bool {
    if len(a) != len(b) {
        return false;
    }
    var i = 0;
    while i < len(a) {
        if a[i] != b[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// `RENAME key newkey` and `RENAMENX key newkey` (`nx`: only if there is no `newkey`, and then 1 or 0).
fn command_rename[&v, &t, &b, &s](view: &v [byte], table: &t [int], sc: &!b [byte], at: int, st: &!s store.Store, nx: bool) -> [] int {
    let src = reply.arg_of(view, table, 1);
    let dst = reply.arg_of(view, table, 2);
    let hs = store.hash_of(st, src);
    let hd = store.hash_of(st, dst);
    if store.find(st, src, hs) < 0 {
        return reply.put(sc, at, "-ERR no such key\r\n");
    }
    if same_bytes(src, dst) {
        if nx {
            return reply.put_integer(sc, at, 0);
        }
        return reply.put(sc, at, "+OK\r\n");
    }
    if nx && store.find(st, dst, hd) >= 0 {
        return reply.put_integer(sc, at, 0);
    }
    if store.rename(st, src, hs, dst, hd) != 0 {
        return reply.refused(sc, at);
    }
    if nx {
        return reply.put_integer(sc, at, 1);
    }
    return reply.put(sc, at, "+OK\r\n");
}

// ---------------------------------------------------------------------
// Hashes (docs/design.md section 19): a packed list of pairs in the value's room
// ---------------------------------------------------------------------

// Bytes of pair header: a 4-byte field length and a 4-byte value length.
fn pair_header() -> [] int {
    return 8;
}

fn get_len[&d](data: &d [byte], at: int) -> [] int {
    return int_of(data[at]) | int_of(data[at + 1]) << 8 | int_of(data[at + 2]) << 16 | int_of(data[at + 3]) << 24;
}

// Does the packed hash `data` hold `field`? Answers `(found, spot)`: `spot` is the offset of the pair's
// header (its field length, then its value) when found, and the offset of the end of the list when not.
fn hash_find[&d, &f](data: &d [byte], field: &f [byte]) -> [] (bool, int) {
    var at = 0;
    while at + pair_header() <= len(data) {
        let flen = get_len(data, at);
        let vlen = get_len(data, at + 4);
        if flen == len(field) {
            var i = 0;
            var same = true;
            while i < flen {
                if data[at + pair_header() + i] != field[i] {
                    same = false;
                }
                i = i + 1;
            }
            if same {
                return (true, at);
            }
        }
        at = at + pair_header() + flen + vlen;
    }
    return (false, at);
}

// The value of the field whose pair header is at `spot`.
fn pair_value[&d](data: &d [byte], spot: int) -> [] &d [byte] {
    let flen = get_len(data, spot);
    let vlen = get_len(data, spot + 4);
    let from = spot + pair_header() + flen;
    return data[from..from + vlen];
}

// How many pairs the packed hash `data` holds.
fn hash_len[&d](data: &d [byte]) -> [] int {
    var at = 0;
    var n = 0;
    while at + pair_header() <= len(data) {
        at = at + pair_header() + get_len(data, at) + get_len(data, at + 4);
        n = n + 1;
    }
    return n;
}

// Set one `field` to `value` on the hash entry `e` (already a hash): append the pair when the field is
// absent, splice the value when it is present. 0: done. 1: no room. `tmp` is at least 8 bytes and at
// least as long as the field and the value (the command's scratch buffer is 64 bytes and a command's
// arguments are at most 16 KiB, so a longer pair is refused with OOM, as Redis would refuse it).
fn hash_set_one[&s, &f, &x](st: &!s store.Store, e: int, field: &f [byte], value: &x [byte]) -> [] int {
    let packed = store.value(st, e);
    let (found, spot) = hash_find(packed, field);
    var end = 0;
    if found {
        // Take the pair out and put a fresh one back: the header's lengths cannot be patched in place
        // (the value's room may move under a compaction), and a delete-then-append is two bounded shifts.
        let old_pair = pair_header() + get_len(packed, spot) + get_len(packed, spot + 4);
        if store.value_splice(st, e, spot, spot + old_pair, "") != 0 {
            return 1;
        }
        end = hash_len_end(store.value(st, e));
    } else {
        end = hash_len_end(packed);
    }
    // The whole pair is built in one region buffer and spliced in at the end, once.
    region a {
        let pair = alloc_slice[a](pair_header() + len(field) + len(value), byte_of(0));
        pair[0] = byte_of(len(field) & 255);
        pair[1] = byte_of(len(field) >> 8 & 255);
        pair[2] = byte_of(len(field) >> 16 & 255);
        pair[3] = byte_of(len(field) >> 24 & 255);
        pair[4] = byte_of(len(value) & 255);
        pair[5] = byte_of(len(value) >> 8 & 255);
        pair[6] = byte_of(len(value) >> 16 & 255);
        pair[7] = byte_of(len(value) >> 24 & 255);
        var i = 0;
        while i < len(field) {
            pair[pair_header() + i] = field[i];
            i = i + 1;
        }
        var j = 0;
        while j < len(value) {
            pair[pair_header() + len(field) + j] = value[j];
            j = j + 1;
        }
        return store.value_splice(st, e, end, end, pair);
    }
}

// Where the packed hash `data` ends: the offset a new pair is appended at.
fn hash_len_end[&d](data: &d [byte]) -> [] int {
    var at = 0;
    while at + pair_header() <= len(data) {
        at = at + pair_header() + get_len(data, at) + get_len(data, at + 4);
    }
    return at;
}

// The entry for a hash command's key, with the kind checked: `(e, o)` where `e` is -1 when the key is
// absent (nothing written) and -2 when the reply is a WRONGTYPE already written at `o`.
fn hash_entry[&v, &t, &b, &s](view: &v [byte], table: &t [int], sc: &!b [byte], at: int, st: &!s store.Store, k: int) -> [] (int, int) {
    let key = reply.arg_of(view, table, k);
    let e = store.find(st, key, store.hash_of(st, key));
    if e < 0 {
        return (0 - 1, at);
    }
    if store.kind_of(st, e) != store.kind_hash() {
        return (0 - 2, reply.wrong_type(sc, at));
    }
    return (e, at);
}

// `HSET`/`HMSET`/`HSETNX key field value [field value ...]`: each field is set; the answer is how many
// fields were not there before (`HSETNX` answers 0/1 for its one pair, `HMSET` answers OK).
fn command_hset[&v, &t, &b, &s, &x](view: &v [byte], table: &t [int], sc: &!b [byte], at: int, st: &!s store.Store, tmp: &!x [byte], nx: bool) -> [] int {
    let key = reply.arg_of(view, table, 1);
    let h = store.hash_of(st, key);
    var e = store.find(st, key, h);
    if e >= 0 && store.kind_of(st, e) == store.kind_string() {
        return reply.wrong_type(sc, at);
    }
    if e < 0 {
        if store.set(st, key, h, "", 0 - 1) != 0 {
            return reply.refused(sc, at);
        }
        e = store.find(st, key, h);
        store.set_kind(st, e, store.kind_hash());
    }
    var added = 0;
    var k = 2;
    while k + 1 < table[0] {
        let field = reply.arg_of(view, table, k);
        let value = reply.arg_of(view, table, k + 1);
        let (found, spot) = hash_find(store.value(st, e), field);
        if found {
            if !nx {
                if hash_set_one(st, e, field, value) != 0 {
                    return reply.refused(sc, at);
                }
            }
        } else {
            if hash_set_one(st, e, field, value) != 0 {
                return reply.refused(sc, at);
            }
            added = added + 1;
        }
        k = k + 2;
    }
    return reply.put_integer(sc, at, added);
}

// ---------------------------------------------------------------------
// Arity
// ---------------------------------------------------------------------

// What Redis calls a command's arity, for the check a transaction makes when a command is queued (`docs/design.md` section 14.2): the
// number of words in the command, its own name included, exactly if positive and at least `-n` if negative; 0 for a command this server
// does not know. These are Redis 7.0's, and `tests/differential.py` checks every one against Redis by queueing the command with one word
// too few, exactly enough and one too many.
pub fn arity[&w](name: &w [byte]) -> [] int {
    if reply.is_word(name, "GET") || reply.is_word(name, "ECHO") || reply.is_word(name, "INCR") || reply.is_word(name, "DECR") || reply.is_word(name, "TTL") || reply.is_word(name, "PTTL") || reply.is_word(name, "PERSIST") || reply.is_word(name, "GETDEL") || reply.is_word(name, "STRLEN") || reply.is_word(name, "TYPE") || reply.is_word(name, "SELECT") || reply.is_word(name, "KEYS") {
        return 2;
    }
    if reply.is_word(name, "INCRBY") || reply.is_word(name, "DECRBY") || reply.is_word(name, "SETNX") || reply.is_word(name, "GETSET") || reply.is_word(name, "RENAME") || reply.is_word(name, "RENAMENX") {
        return 3;
    }
    if reply.is_word(name, "SETEX") || reply.is_word(name, "PSETEX") || reply.is_word(name, "GETRANGE") || reply.is_word(name, "SUBSTR") || reply.is_word(name, "SETRANGE") {
        return 4;
    }
    if reply.is_word(name, "APPEND") {
        return 3;
    }
    if reply.is_word(name, "HGET") || reply.is_word(name, "HEXISTS") || reply.is_word(name, "HSTRLEN") {
        return 3;
    }
    if reply.is_word(name, "HINCRBY") {
        return 4;
    }
    if reply.is_word(name, "HLEN") || reply.is_word(name, "HGETALL") || reply.is_word(name, "HKEYS") || reply.is_word(name, "HVALS") {
        return 2;
    }
    if reply.is_word(name, "HDEL") || reply.is_word(name, "HMGET") || reply.is_word(name, "HSCAN") {
        return 0 - 3;
    }
    if reply.is_word(name, "HRANDFIELD") {
        return 0 - 2;
    }
    if reply.is_word(name, "HSET") || reply.is_word(name, "HMSET") || reply.is_word(name, "HSETNX") {
        return 0 - 4;
    }
    if reply.is_word(name, "DBSIZE") || reply.is_word(name, "RESET") || reply.is_word(name, "MULTI") || reply.is_word(name, "EXEC") || reply.is_word(name, "DISCARD") || reply.is_word(name, "UNWATCH") || reply.is_word(name, "RANDOMKEY") {
        return 1;
    }
    if reply.is_word(name, "PING") || reply.is_word(name, "FLUSHALL") || reply.is_word(name, "FLUSHDB") || reply.is_word(name, "HELLO") || reply.is_word(name, "INFO") || reply.is_word(name, "COMMAND") || reply.is_word(name, "QUIT") {
        return 0 - 1;
    }
    if reply.is_word(name, "DEL") || reply.is_word(name, "UNLINK") || reply.is_word(name, "EXISTS") || reply.is_word(name, "TOUCH") || reply.is_word(name, "MGET") || reply.is_word(name, "AUTH") || reply.is_word(name, "CLIENT") || reply.is_word(name, "CONFIG") || reply.is_word(name, "WATCH") || reply.is_word(name, "GETEX") || reply.is_word(name, "SCAN") {
        return 0 - 2;
    }
    if reply.is_word(name, "SET") || reply.is_word(name, "EXPIRE") || reply.is_word(name, "PEXPIRE") || reply.is_word(name, "MSET") || reply.is_word(name, "MSETNX") {
        return 0 - 3;
    }
    return 0;
}
