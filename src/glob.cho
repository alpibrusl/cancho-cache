edition 5;

module glob;

// `glob` -- Redis's pattern matching (`stringmatchlen`), for `KEYS` and `SCAN MATCH`: `*` matches any run of bytes, `?` any one, `[abc]`
// a set, `[^abc]` its complement, `[a-c]` a range (either way round), and `\x` the byte `x`. A set that is not closed runs to the end of the
// pattern, and a `\` at the end is itself, as in Redis. It works on bytes, never indexes outside the pattern or the text, and uses no
// recursion: a `*` remembers where it was and a mismatch tries it one byte further on.

// Does the one-byte element of `pattern` that starts at `p` (never a `*`) match the byte `c`? And where does the next element start?
fn element[&w](pattern: &w [byte], p: int, c: int) -> [] (bool, int) {
    let n = len(pattern);
    let ch = int_of(pattern[p]);
    if ch == '?' {
        return (true, p + 1);
    }
    if ch == '[' {
        var q = p + 1;
        var not = false;
        if q < n && int_of(pattern[q]) == '^' {
            not = true;
            q = q + 1;
        }
        var matched = false;
        var going = true;
        var end = q;
        while going {
            let left = n - q;
            if left >= 2 && int_of(pattern[q]) == '\\' {
                if int_of(pattern[q + 1]) == c {
                    matched = true;
                }
                q = q + 2;
            } else if left >= 1 && int_of(pattern[q]) == ']' {
                going = false;
                end = q + 1;
            } else if left == 0 {
                going = false;
                end = q;
            } else if left >= 3 && int_of(pattern[q + 1]) == '-' {
                var first = int_of(pattern[q]);
                var last = int_of(pattern[q + 2]);
                if first > last {
                    let t = first;
                    first = last;
                    last = t;
                }
                if c >= first && c <= last {
                    matched = true;
                }
                q = q + 3;
            } else {
                if int_of(pattern[q]) == c {
                    matched = true;
                }
                q = q + 1;
            }
        }
        if not {
            matched = !matched;
        }
        return (matched, end);
    }
    if ch == '\\' && p + 1 < n {
        return (int_of(pattern[p + 1]) == c, p + 2);
    }
    return (ch == c, p + 1);
}

// Whether `text` matches `pattern` as a whole.
pub fn matches[&w, &x](pattern: &w [byte], text: &x [byte]) -> [] bool {
    let n = len(pattern);
    var p = 0;
    var s = 0;
    var star_p = 0 - 1;
    var star_s = 0;
    while s < len(text) {
        if p < n && int_of(pattern[p]) == '*' {
            while p < n && int_of(pattern[p]) == '*' {
                p = p + 1;
            }
            star_p = p;
            star_s = s;
        } else {
            var ok = false;
            if p < n {
                let (m, next) = element(pattern, p, int_of(text[s]));
                if m {
                    ok = true;
                    p = next;
                    s = s + 1;
                }
            }
            if !ok {
                if star_p < 0 {
                    return false;
                }
                star_s = star_s + 1;
                s = star_s;
                p = star_p;
            }
        }
    }
    while p < n && int_of(pattern[p]) == '*' {
        p = p + 1;
    }
    return p == n;
}
