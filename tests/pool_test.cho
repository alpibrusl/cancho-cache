import std.test;
import pool;

// `pool`: numbers handed out and taken back, the lowest first, nothing out of range ever indexed.

fn test_a_full_pool_hands_out_every_number_once_and_then_says_so() -> [] int {
    region a {
        let p = alloc_slice[a](5, 0);
        test.assert_eq(pool.fill(p), 4);
        test.assert_eq(pool.free(p), 4);
        var seen = 0;
        var i = 0;
        while i < 4 {
            let b = pool.take(p);
            test.assert_eq(b, i);
            seen = seen + (1 << b);
            i = i + 1;
        }
        test.assert_eq(seen, 15);
        test.assert_eq(pool.take(p), 0 - 1);
        test.assert_eq(pool.take(p), 0 - 1);
        test.assert_eq(pool.free(p), 0);
    }
    return 0;
}

fn test_a_block_given_back_is_the_next_taken() -> [] int {
    region a {
        let p = alloc_slice[a](4, 0);
        pool.fill(p);
        let x = pool.take(p);
        let y = pool.take(p);
        test.assert_eq(pool.give(p, x), 0);
        test.assert_eq(pool.take(p), x);
        test.assert_eq(pool.give(p, y), 0);
        test.assert_eq(pool.give(p, x), 0);
        test.assert_eq(pool.take(p), x);
        test.assert_eq(pool.take(p), y);
        test.assert_eq(pool.free(p), 1);
    }
    return 0;
}

fn test_a_number_that_cannot_be_right_is_refused_and_changes_nothing() -> [] int {
    region a {
        let p = alloc_slice[a](3, 0);
        pool.fill(p);
        // Full already: giving one back would be giving one twice.
        test.assert_eq(pool.give(p, 0), 0 - 1);
        let x = pool.take(p);
        test.assert_eq(pool.give(p, 0 - 1), 0 - 1);
        test.assert_eq(pool.give(p, 2), 0 - 1);
        test.assert_eq(pool.give(p, 7), 0 - 1);
        test.assert_eq(pool.free(p), 1);
        // Given back once, it is accepted; given back again the pool is full and it is refused.
        test.assert_eq(pool.give(p, x), 0);
        test.assert_eq(pool.give(p, x), 0 - 1);
        test.assert_eq(pool.free(p), 2);
    }
    return 0;
}

// Many turns of taking and giving back against a model that keeps the set of numbers out.
fn test_a_run_of_takes_and_gives_agrees_with_a_model() -> [] int {
    region a {
        let n = 16;
        let p = alloc_slice[a](n + 1, 0);
        let out = alloc_slice[a](n, 0);
        pool.fill(p);
        var held = 0;
        var seed = 12345;
        var step = 0;
        while step < 4000 {
            seed = seed * 1103515245 + 12345 & 0x7fffffff;
            if (seed >> 8) % 3 != 0 {
                let b = pool.take(p);
                if held == n {
                    test.assert_eq(b, 0 - 1);
                } else {
                    test.assert(b >= 0 && b < n);
                    test.assert_eq(out[b], 0);
                    out[b] = 1;
                    held = held + 1;
                }
            } else if held > 0 {
                var b = (seed >> 12) % n;
                while out[b] == 0 {
                    b = (b + 1) % n;
                }
                out[b] = 0;
                held = held - 1;
                test.assert_eq(pool.give(p, b), 0);
            }
            test.assert_eq(pool.free(p), n - held);
            step = step + 1;
        }
    }
    return 0;
}
